{
  "name": "artistsarejerks-astro",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "community:dev": "wrangler dev --config community-api/wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "community:migrate": "wrangler d1 migrations apply aaj-community-local --local --config community-api/wrangler.jsonc",
    "community:types": "wrangler types --config community-api/wrangler.jsonc community-api/worker-configuration.d.ts",
    "test:community": "node tests/community-storage.integration.mjs && node tests/member-artist-handoff.mjs && node tests/artist-intake.mjs && node tests/artist-messages.mjs && node tests/followers.mjs && node tests/directory-navigation.mjs",
    "community:check": "tsc --project community-api/tsconfig.json",
    "build:test": "astro check && node scripts/build-test.mjs",
    "test:deploy:check": "wrangler deploy --dry-run --config wrangler.test.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/node": "^9.5.5",
    "@clerk/astro": "^4.1.3",
    "astro": "^5.17.2",
    "jose": "^6.2.12",
    "webcoreui": "^1.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^25.0.10",
    "sass": "^1.97.3",
    "typescript": "^5.7.3",
    "wrangler": "^4.134.0"
  }
}
