---
import BaseLayout from '../layouts/BaseLayout.astro';

// Each tool digs from the surface story down to what's underneath; tones run light to dark.
type Tone = 'cream' | 'gold' | 'orange' | 'crimson' | 'black';
type Layer = {label: string; tone: Tone; items: string[]};
type Tool = {id: string; pill: string; name: string; about: string; note?: string; layers: Layer[]};

const tools: Tool[] = [
  {
    id: 'seen', pill: 'Wanting to be seen', name: 'Wanting to be seen',
    about: "The bind: you're supposed to make art for yourself, and also share it, and also somehow not care what happens next.",
    layers: [
      {label: 'What you tell everyone', tone: 'cream', items: ['"I just make what I need to make."', '"Art shouldn\'t be about the audience."', '"I don\'t check the numbers."', '"Real artists don\'t need validation."']},
      {label: 'What you actually do', tone: 'gold', items: ['Check Instagram likes at 2 a.m.', 'Google your own name to see if anyone mentioned your work.', 'Feel deflated when something gets no response.', 'Feel guilty when something does.']},
      {label: 'The spiral', tone: 'orange', items: ['Wanting attention makes me a fake.', "If I admit I want recognition, I'm just like everyone else.", "Real suffering artists don't care about being seen.", "Needing validation means the work isn't enough on its own."]},
      {label: 'The fear underneath', tone: 'crimson', items: ["What if I'm only doing this to feel special?", "What if all my pure motives are really just wanting attention?", "What if I can't tell being honest from performing honesty?"]},
      {label: "What's actually true", tone: 'black', items: ['Wanting to be seen is human, not an artistic failure.', 'The shame about wanting it blocks more work than the wanting does.', 'You can want attention and still make honest work.']},
    ],
  },
  {
    id: 'fear', pill: 'Fear', name: 'Fear',
    about: 'Where the real blocks live. The stuff that keeps you up at 3 a.m.',
    note: "This one doesn't end with comfort. It names the fears you've been avoiding. If you're in a fragile place, save it for later.",
    layers: [
      {label: 'The fears you admit to', tone: 'cream', items: ["It won't be good enough.", "People will think I'm pretentious.", "I'll embarrass myself."]},
      {label: 'The ones under those', tone: 'orange', items: ["If I make this, I can't pretend I'm not an artist anymore.", 'This might show who I actually am.', 'What if I succeed and have to keep being this person?', "What if this shows I'm not who I think I am?"]},
      {label: 'The big ones', tone: 'crimson', items: ['What if my real voice is ugly?', 'What if I\'m ordinary, and making things was just how I coped?', 'What if I\'ve been hiding behind "not ready yet" my whole life?', 'What if I make something true and nobody cares?', 'What if I find out I actually hate making things?']},
      {label: 'The bottom', tone: 'black', items: ['Who would I be if I weren\'t the person who "might make art someday"?', "What if my ideas aren't special and I'm just another person with hands?", 'What if I make this and realize I wasted decades not making?']},
    ],
  },
  {
    id: 'choices', pill: 'Choices', name: 'Choices',
    about: "This one doesn't tell you what to do. It helps you notice why you're doing it. Think of a creative decision you're facing right now.",
    layers: [
      {label: 'The choice in front of you', tone: 'cream', items: ['Store-bought: familiar, safe, efficient.', 'Homemade: complicated, risky, personal.']},
      {label: 'Ask yourself', tone: 'orange', items: ['Am I choosing this because it fits the situation?', "Am I choosing this because I'm afraid of failing?", 'Am I choosing this to prove something?', 'Am I choosing this because someone said I should?', 'What would I choose if no one were watching?']},
      {label: "What's actually true", tone: 'black', items: ['Fear is information, not a verdict.', 'Both choices can be right for different reasons.', 'Patterns repeat until you notice them.', "Noticing doesn't mean you have to change."]},
    ],
  },
];

const principles = [
  ['No solutions', "Nothing here tells you how to overcome anything. Seeing the pattern is the work."],
  ['Honesty over positivity', 'The art world runs on "just make what you love!" These assume you can handle the truth about what\'s blocking you.'],
  ['Patterns repeat until noticed', 'You keep hitting the same wall until you name it. Once you do, it loses some of its grip.'],
  ['Contradictions are normal', "You can want recognition and make honest work. You can be terrified and keep making. You can play it safe sometimes and take risks other times."],
];
---
<BaseLayout title="Thinking Like an Artist - Artists Are Jerks" bodyClass="thinking-page">
  <div class="thinking-page-body">
    <header class="thinking-header">
      <h1>Thinking Like an Artist</h1>
      <p class="lede">Making art stirs up feelings people don't expect: pride, shame, fear, a strange hunger to be seen. If you're new to it, those feelings can seem like a sign you're doing it wrong. They're not. They're part of the job. Below are three of the most common ones, peeled back layer by layer, from what artists say out loud to what's really going on underneath.</p>
    </header>

    <div class="pills" role="group" aria-label="Three tools" data-pills hidden>
      {tools.map((tool, index) => (
        <button type="button" class="pill" data-tool={tool.id} aria-pressed={index === 0 ? 'true' : 'false'}>{tool.pill}</button>
      ))}
    </div>

    {tools.map((tool) => (
      <section class="tool" id={tool.id} data-panel={tool.id} aria-labelledby={`${tool.id}-title`}>
        <h2 class="tool-title" id={`${tool.id}-title`}>{tool.name}</h2>
        <p class="tool-about">{tool.about}</p>
        {tool.note && <p class="tool-note">{tool.note}</p>}
        <ol class="layers">
          {tool.layers.map((layer) => (
            <li class={`layer layer--${layer.tone}`}>
              <h3 class="layer-label">{layer.label}</h3>
              <ul>{layer.items.map((item) => <li>{item}</li>)}</ul>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <section class="closing">
      <h2>Why this works</h2>
      <p>Most creative advice tries to fix you, as if shame and fear and contradiction were bugs to patch. These assume those feelings are information.</p>
      <dl>
        {principles.map(([term, text]) => (<><dt>{term}</dt><dd>{text}</dd></>))}
      </dl>
      <h2>Related</h2>
      <ul class="related">
        <li><a href="/whats-a-jerk/">What's a Jerk?</a> How these private knots show up as public jerk behavior.</li>
        <li><a href="/about/">About Alan</a> Where these ideas connect to the philosophers.</li>
        <li><a href="/attention-lab/">Attention Lab</a> For when fear has you frozen and you need something concrete to judge the work by.</li>
      </ul>
      <p class="closing-note">None of this is meant to make you feel better. It's meant to help you see clearer. Once you see the pattern, you can decide what to do about it. Or you can do nothing and keep watching yourself do it. That's allowed too.</p>
    </section>
  </div>

  <script>
    // Without JavaScript every tool stays visible; with it, the pills show one at a time.
    const pills = document.querySelector<HTMLElement>('[data-pills]');
    const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
    if (pills) {
      pills.hidden = false;
      const show = (id: string) => {
        panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== id; });
        pills.querySelectorAll<HTMLButtonElement>('[data-tool]').forEach((pill) => pill.setAttribute('aria-pressed', String(pill.dataset.tool === id)));
      };
      pills.addEventListener('click', (event) => {
        const pill = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tool]');
        if (pill?.dataset.tool) show(pill.dataset.tool);
      });
      const hash = location.hash.slice(1);
      show(hash && document.getElementById(hash) ? hash : panels[0].dataset.panel!);
    }
  </script>

  <style>
    .thinking-page-body { max-width: var(--max-width-text); margin: 0 auto; padding: var(--space-4) 0 var(--space-12); color: var(--color-black); }
    .thinking-header { text-align: center; margin-bottom: var(--space-5); }
    .thinking-header h1 { margin: 0 0 var(--space-2); font-family: var(--font-heading); font-size: var(--font-size-4xl); }
    .lede { max-width: 32rem; margin: 0 auto; text-align: left; font-size: var(--font-size-lg); line-height: var(--line-height-normal); }
    .pills { display: flex; gap: var(--space-2); margin: 0 calc(var(--page-gutter-mobile) * -1) var(--space-4); padding: 0 var(--page-gutter-mobile) var(--space-1); overflow-x: auto; scrollbar-width: none; }
    .pills[hidden] { display: none; }
    .pill { flex: none; min-height: 44px; padding: 0 var(--space-4); background: var(--color-cream); border: 0; border-radius: var(--radius-base); color: var(--color-black); font-family: var(--font-heading); font-size: var(--font-size-base); cursor: pointer; }
    .pill[aria-pressed='true'] { background: var(--color-green); font-weight: var(--font-weight-bold); }
    .pill:focus-visible { outline: var(--border-base) solid var(--color-black); outline-offset: var(--border-base); }
    .tool { margin-bottom: var(--space-6); }
    .tool[hidden] { display: none; }
    .tool-title { margin: 0 0 var(--space-1); font-family: var(--font-heading); font-size: var(--font-size-2xl); }
    .tool-about { margin: 0 0 var(--space-3); line-height: var(--line-height-relaxed); }
    .tool-note { margin: 0 0 var(--space-3); padding: var(--space-2) var(--space-3); border-left: var(--border-thick) solid var(--color-black); font-style: italic; line-height: var(--line-height-relaxed); }
    .layers { margin: 0; padding: 0; list-style: none; border: var(--border-base) solid var(--color-black); border-radius: var(--radius-lg); overflow: hidden; }
    .layer { padding: var(--space-3) var(--space-4) var(--space-4); }
    .layer ul { margin: 0; padding-left: var(--space-5); line-height: var(--line-height-relaxed); }
    .layer-label { margin: 0 0 var(--space-1); font-family: var(--font-heading); font-size: var(--font-size-sm); font-weight: var(--font-weight-bold); letter-spacing: var(--letter-spacing-wider); text-transform: uppercase; }
    .layer--cream { background: var(--color-cream); }
    .layer--gold { background: var(--color-gold); }
    .layer--orange { background: var(--color-burnt-orange); color: var(--color-white); }
    .layer--crimson { background: var(--color-plum-red); color: var(--color-white); }
    .layer--black { background: var(--color-black); color: var(--color-white); }
    .layer--black .layer-label { color: var(--color-gold); }
    .closing { margin-top: var(--space-8); padding: var(--space-4) var(--space-5); background: var(--color-cream); border: var(--border-base) solid var(--color-black); border-radius: var(--radius-lg); }
    .closing h2 { margin: 0 0 var(--space-3); font-family: var(--font-heading); font-size: var(--font-size-2xl); }
    .closing h2 + p { margin-top: 0; }
    .closing p, .closing dd, .related { line-height: var(--line-height-relaxed); }
    .closing dl { margin: 0 0 var(--space-6); }
    .closing dt { margin-top: var(--space-3); font-family: var(--font-heading); font-size: var(--font-size-sm); font-weight: var(--font-weight-bold); color: var(--color-purple); }
    .closing dd { margin: 0; }
    .related { margin: 0 0 var(--space-4); padding-left: var(--space-5); }
    .related a { color: var(--color-purple); font-weight: var(--font-weight-bold); }
    .closing-note { margin-bottom: 0; padding-top: var(--space-3); border-top: var(--border-thin) solid var(--color-black); }
    @media (min-width: 900px) {
      .thinking-header h1 { font-size: var(--font-size-5xl); }
      .pills { justify-content: center; margin-inline: 0; padding-inline: 0; }
    }
  </style>
</BaseLayout>
