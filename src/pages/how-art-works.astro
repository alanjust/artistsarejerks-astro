---
import BaseLayout from '../layouts/BaseLayout.astro';

const artTypes = [
  {
    id: 'gallery',
    chip: 'Gallery',
    title: 'Gallery art',
    tagline: 'Art for the few',
    description: "This is art made for the art world: critics, curators, collectors, and other artists. It prizes new ideas and rewards people who know the backstory. It's the stuff that gets reviewed, shown in white rooms, and argued about in grad school.",
    artist: 'Respect from people whose respect is hard to get. A gallery, a museum show, a career.',
    viewer: "A puzzle worth working on. Also, if we're being honest, a little status.",
    traits: [
      'Makes more sense once you know some art history',
      'Often starts with an idea rather than a look',
      'One of a kind, or a small edition',
      'Expensive',
      'Shown in galleries, museums, and biennials',
      'Written about by critics and scholars',
    ],
    examples: "Damien Hirst's shark in formaldehyde, Marina Abramović's performances, Jeff Koons' balloon dogs, Ai Weiwei's political installations.",
  },
  {
    id: 'spectacle',
    chip: 'Spectacle',
    title: 'Spectacle art',
    tagline: 'Art for the masses',
    description: "This is art built to stop you in your tracks. It's big, it's immersive, and it looks great on your phone. The line out the door is part of the point.",
    artist: 'A huge audience. Ticket sales, merch, and a following.',
    viewer: "A great afternoon with friends. And a way into contemporary art that doesn't ask for homework first.",
    traits: [
      'Hits you right away',
      'Surrounds you, or asks you to join in',
      'Made to be photographed and shared',
      'Big',
      'Usually ticketed, or out in public',
      'Marketed to everybody, not to insiders',
    ],
    examples: "teamLab's digital rooms, Yayoi Kusama's Infinity Rooms, Meow Wolf, light festivals, projection mapping.",
  },
  {
    id: 'everyday',
    chip: 'Everyday',
    title: 'Everyday art',
    tagline: 'Art for daily life',
    description: "This is the art over the couch, in the hotel hallway, in the dentist's waiting room. It decorates, it calms things down, it goes with the rug. That's not a lesser job. It's just a different one.",
    artist: 'Steady income, and the quiet pleasure of making ordinary rooms nicer to be in.',
    viewer: "Something good to look at every day, at a price you can live with.",
    traits: [
      'Pleasant to look at',
      'Fits into lots of different rooms',
      "Doesn't need an explanation",
      'Affordable, sometimes mass-produced',
      'Sold in home stores, online shops, and to hotels',
      'Made to live with, not to study',
    ],
    examples: 'Prints from West Elm or CB2, hotel lobby paintings, botanical prints, landscape photos, big soft abstracts in office lobbies, Etsy prints.',
  },
];

const insights = [
  ['None of these is better', "Gallery art isn't superior to everyday art. A Jeff Koons and a West Elm print can both be excellent at their own jobs."],
  ['Artists switch jobs', 'Plenty of artists make gallery work and commercial work. Some start in spectacle and end up in museums. Some do all three at once.'],
  ['What you want counts', 'Wanting a painting that makes your living room feel cozy is as legitimate as wanting one that makes you rethink sculpture.'],
  ['The fights are mix-ups', "Most art-world Jerk behavior comes from grading one job by another's rules. Hotel art isn't failing at being conceptual. It was never trying."],
];
---
<BaseLayout title="How Art Works - Artists Are Jerks" bodyClass="how-art-works-page">
  <div class="works-page">
    <header class="works-header">
      <h1>How Art Works</h1>
      <p class="lede">Art does three different jobs. Most fights in the art world come from judging one job by another's rules.</p>
      <nav class="chips" aria-label="The three kinds of art">
        {artTypes.map((type) => <a class="chip" href={`#${type.id}`}>{type.chip}</a>)}
      </nav>
    </header>

    <ol class="types">
      {artTypes.map((type, index) => (
        <li class="card" id={type.id}>
          <h2 class="card-title"><span class="card-number" aria-hidden="true">{index + 1}</span>{type.title}</h2>
          <p class="card-tagline">{type.tagline}</p>
          <p>{type.description}</p>
          <h3 class="card-label">What the artist gets</h3>
          <p>{type.artist}</p>
          <h3 class="card-label">What you get</h3>
          <p>{type.viewer}</p>
          <h3 class="card-label">How to spot it</h3>
          <ul class="traits">{type.traits.map((trait) => <li>{trait}</li>)}</ul>
          <h3 class="card-label">Examples</h3>
          <p>{type.examples}</p>
        </li>
      ))}
    </ol>

    <section class="card closing">
      <h2 class="card-title">Why this matters</h2>
      {insights.map(([heading, text]) => (
        <>
          <h3 class="card-label">{heading}</h3>
          <p>{text}</p>
        </>
      ))}
      <p class="closing-note">Once you know what job a piece of art is doing, you can judge it on its own terms. You can also spot the people pretending only one job counts. That's usually where the Jerks are.</p>
    </section>
  </div>

  <style>
    .works-page { max-width: var(--max-width-text); margin: 0 auto; padding: var(--space-4) 0 var(--space-12); }
    .works-header { text-align: center; margin-bottom: var(--space-6); }
    .works-header h1 { margin: 0 0 var(--space-2); font-family: var(--font-heading); font-size: var(--font-size-4xl); color: var(--color-black); }
    .lede { max-width: 32rem; margin: 0 auto var(--space-4); font-size: var(--font-size-lg); line-height: var(--line-height-normal); color: var(--color-black); }
    .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2); }
    .chip { display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--space-4); background: var(--color-cream); border: var(--border-base) solid var(--color-black); border-radius: var(--radius-full); color: var(--color-black); font-family: var(--font-heading); font-weight: var(--font-weight-bold); text-decoration: none; }
    .chip:hover, .chip:focus-visible { background: var(--color-black); color: var(--color-gold); }
    .types { display: grid; gap: var(--space-4); margin: 0 0 var(--space-4); padding: 0; list-style: none; }
    .card { scroll-margin-top: var(--space-4); padding: var(--space-4) var(--space-5); background: var(--color-cream); border: var(--border-base) solid var(--color-black); border-radius: var(--radius-lg); color: var(--color-black); }
    .card p { margin: 0; font-size: var(--font-size-base); line-height: var(--line-height-relaxed); }
    .card-title { display: flex; align-items: center; gap: var(--space-3); margin: 0; font-family: var(--font-heading); font-size: var(--font-size-2xl); line-height: var(--line-height-tight); }
    .card-number { display: grid; place-items: center; flex: none; width: var(--space-8); height: var(--space-8); border-radius: var(--radius-full); background: var(--color-black); color: var(--color-gold); font-size: var(--font-size-base); }
    .card .card-tagline { margin: var(--space-1) 0 var(--space-3); font-style: italic; }
    .card-label { margin: var(--space-4) 0 var(--space-1); font-family: var(--font-heading); font-size: var(--font-size-sm); font-weight: var(--font-weight-bold); color: var(--color-purple); }
    .traits { margin: 0; padding-left: var(--space-5); line-height: var(--line-height-relaxed); }
    .card .closing-note { margin-top: var(--space-4); padding-top: var(--space-4); border-top: var(--border-thin) solid var(--color-black); }
    @media (min-width: 900px) {
      .works-header h1 { font-size: var(--font-size-5xl); }
    }
  </style>
</BaseLayout>
