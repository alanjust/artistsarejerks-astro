---
export const prerender = false;
import {communityAccess} from '../lib/community-access';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/venue-workspace.css';
const { isAuthenticated, userId } = Astro.locals.auth();
if (!isAuthenticated) return Astro.redirect('/sign-in/');
const onlineTest = import.meta.env.MODE === 'online-test';
const access = await communityAccess(userId,Astro.locals);
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<BaseLayout title="Your account | Artists Are Jerks" noindex><main class="venue-workspace">
<h1>Your account</h1>
<p>Everything you run on Artists Are Jerks, in one place. Your name, your email, and the Sign out button are in the bar above.</p>
{access ? <section class="card">
  <h2>Your pages</h2>
  {access.artistId && <p><a href={`/prototype/workspace/member/?artist=${encodeURIComponent(access.artistId)}`}>Open your artist workspace →</a><br/><small>Your artwork, showings, messages, and public page.</small></p>}
  {access.venueId && <p><a href={`/prototype/venues/workspace/?venue=${encodeURIComponent(access.venueId)}`}>Open your venue workspace →</a><br/><small>Your place’s details, hours, and listing.</small></p>}
  {access.artistId && !access.venueId && <p><small>Run a café, shop, or studio that shows art? <a href="/for-venues/">Introduce your place →</a></small></p>}
  {access.venueId && !access.artistId && <p><small>Make art yourself? <a href="/join/?kind=artist">Join as an artist →</a></small></p>}
  {access.administrator && <><h3>Administrator tools</h3><ul><li><a href="/prototype/admin/inbox/">Inbox →</a></li><li><a href="/prototype/admin/accounts/">Account assignments →</a></li><li><a href="/prototype/admin/venues/">Review venue applications →</a></li><li><a href="/prototype/storage/">Storage settings →</a></li></ul></>}
</section> : <section class="card">
  <h2>Nothing here yet</h2>
  <p>This account doesn’t have an artist page or a venue yet.</p>
  <p><a href="/join/?kind=artist">Make art? Join as an artist →</a></p>
  <p><a href="/for-venues/">Have a wall? Introduce your place →</a></p>
</section>}
<p class="notice">{onlineTest ? 'This is the private test site. What you do here is saved separately from the real site, and test pages may be cleared before launch.' : 'Local development. Changes are saved on this computer only.'}</p>
</main></BaseLayout>
