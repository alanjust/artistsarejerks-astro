---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import pilot from '../data/community-pilot.json';
import '../styles/venue-workspace.css';
import '../styles/moderation.css';
const onlineTest = import.meta.env.MODE === 'online-test';
const {isAuthenticated} = Astro.locals.auth();
const user = isAuthenticated ? await Astro.locals.currentUser() : null;
const accountName = [user?.firstName, user?.lastName].filter(Boolean).join(' ');
const accountEmail = user?.primaryEmailAddress?.emailAddress ?? user?.emailAddresses?.[0]?.emailAddress ?? '';
const back = encodeURIComponent('/join/?kind=artist');
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<BaseLayout title="Join the Community | Artists Are Jerks" noindex>
<main class="venue-workspace join-page">
<p>Rogue Valley · Artists Are Jerks</p><h1>Join the community</h1><p>Help people find artwork they can stand in front of, and the places that show it.</p>
<p class="notice"><strong>{onlineTest ? 'Private online test' : 'Local prototype'}:</strong> Applications save to {onlineTest ? 'the protected test site' : 'local development storage'}. An artist can start building a private page right after applying; it goes public once an administrator approves it.</p>
<div class="public-grid" data-join-choices>
<section class="card"><h2>I’m an artist</h2><p>For visual artists, including those showing in restaurants, studios, and other local spaces. This is an art community, not a crafts marketplace.</p><button type="button" data-open-artist>Request consideration →</button></section>
<section class="card"><h2>I represent a venue</h2><p>Introduce your space and tell artists you’re available to host their work. An administrator approves each venue before its workspace opens.</p><a class="button" href="/join/venue/">Apply as a venue →</a></section>
<section class="card"><h2>My area isn’t listed</h2><p>Propose a city or region where local artists and venues could start a new Artists Are Jerks community.</p><a class="button" href="/join/region/">Propose a region →</a></section>
</div>

{!user && <section class="card" data-signup-prompt hidden>
  <h2>First, a free account</h2>
  <p>You’ll make an account before you apply, so your request, and the page you’ll build, stay with you.</p>
  <div class="actions"><a class="button" href={`/sign-up/?next=${back}`}>Create an account →</a><a class="button" href={`/sign-in/?next=${back}`}>I already have one</a><button type="button" data-close-artist>Back to choices</button></div>
</section>}

{user && <form class="card" data-artist-application hidden>
  <h2 data-application-title>Tell us who you are</h2>
  <p data-application-intro>A few quick things, and two or three pieces. A real person reads every request.</p>
  <div class="fields" data-about-fields>
    <label>Artist name<input name="name" required maxlength="150" value={accountName} autocomplete="name"/></label>
    <label>Home city<input name="city" required list="region-cities" maxlength="120" autocomplete="address-level2"/><datalist id="region-cities">{pilot.regions[0]?.cities.map((city) => <option value={city}/>)}</datalist></label>
    <label class="full">What do you make?<input name="practice" required maxlength="200" placeholder="Painting, printmaking, ceramics…"/></label>
    <label class="full">Where can we see your work?<textarea name="where" required rows="2" maxlength="2000" placeholder="yourwebsite.com, or “Paintings at the Medford library through May”"></textarea><small>A link to your website or Instagram, or a sentence about where it hangs. Either one is fine.</small></label>
    <label class="full" data-region-field>Region<select name="regionId" data-region-select><option value="region-rogue-valley">Rogue Valley · OR</option></select></label>
  </div>
  <fieldset class="join-samples" data-samples>
    <legend>Two or three pieces</legend>
    <div class="join-standard">
      <p><strong>What belongs here:</strong> art made to be looked at. Painting, drawing, printmaking, photography, collage, mixed media, sculpture. Ceramics and glass count when they’re made for display rather than for use.</p>
      <p><strong>What doesn’t:</strong> crafts, useful objects, and merchandise—jewelry, cutting boards, mugs, printed T-shirts. There are good places for those. This just isn’t one of them.</p>
      <p>Made it with AI? That’s fine. Check the box, and it gets a small label.</p>
    </div>
    <p>Pick pieces you made that show what you do. They’ll be the first pieces on your page.</p>
    <div class="sample-picks" data-sample-picks></div>
    <label class="button" data-sample-add>Add a photo<input class="sr-only" type="file" accept="image/jpeg,image/png,image/webp" multiple data-sample-input/></label>
    <p><small>JPEG, PNG, or WebP, up to 10 MB each.</small></p>
  </fieldset>
  <label class="check terms-check"><input type="checkbox" name="agreeTerms" data-agree-terms/> <span>I’ve read and agree to the <a href="/artist-terms/" target="_blank">Artist Terms</a> and <a href="/guidelines/" target="_blank">Community Guidelines</a>. I’ve also read the <a href="/privacy/" target="_blank">Privacy Notice</a>.</span></label>
  <p class="account-email">We’ll write to you at <strong>{accountEmail || 'the email on your account'}</strong>. <a href="/account/">Change it in your account</a></p>
  <div class="actions"><button>Send my request</button><button type="button" data-close-artist>Back to choices</button></div>
  <p data-application-error role="status"></p>
</form>}

<p class="other-ways" data-other-ways hidden>Not an artist? Venues: <a href="/for-venues/">introduce your place →</a> · Your area isn’t listed? <a href="/join/region/">Propose it →</a></p>
<section class="card" data-join-result hidden role="status"></section>
<section class="card" data-existing-application hidden></section>
{user && <details open><summary>Your artist requests</summary><div data-my-applications></div></details>}
</main>
<script>
import {initJoin} from '../lib/join-community';initJoin();
</script>
</BaseLayout>
<style>
.account-email { margin-top: var(--space-4); }
.account-email a, .terms-check a { color: var(--color-gold); }
.other-ways a { color: var(--color-purple-dark); font-weight: var(--font-weight-bold); }
.terms-check { font-weight: var(--font-weight-normal); }
</style>
