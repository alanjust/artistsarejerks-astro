---
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {communityAccess} from '../../../lib/community-access';
import '../../../styles/venue-workspace.css';

const onlineTest = import.meta.env.MODE === 'online-test';
const {isAuthenticated,userId}=Astro.locals.auth();
const access=isAuthenticated?await communityAccess(userId,Astro.locals):null;
const artistWorkspace=access?.artistId==='artist-alan-just'?'/prototype/workspace/':access?.artistId?`/prototype/workspace/member/?artist=${encodeURIComponent(access.artistId)}`:'';
const sections:{title:string;text:string;links:[string,string][]}[]=[];

if(onlineTest){
 if(artistWorkspace)sections.push({title:'Your artist workspace',text:'Manage your profile, artwork, visibility, and physical showings.',links:[['Open your artist workspace →',artistWorkspace]]});
 if(access?.venueId)sections.push({title:'Your venue workspace',text:'Manage the information for the venue assigned to your account.',links:[['Open your venue workspace →',`/prototype/venues/workspace/?venue=${encodeURIComponent(access.venueId)}`]]});
 if(access?.administrator)sections.push({title:'Administrator tools',text:'Review applications, approve regions, and assign approved artists and venues to their accounts.',links:[['Assign account access →','/prototype/admin/accounts/'],['Review artist applications →','/prototype/admin/artists/'],['Review venue applications →','/prototype/admin/venues/'],['Review region proposals →','/prototype/admin/regions/']]});
 const communityLinks:[string,string][]=[['Showing Now →','/showing-now/'],['Places to See Art →','/prototype/venues/']];
 if(access?.artistId)communityLinks.push(['View your artist page →',access.artistId==='artist-alan-just'?'/prototype/artists/alan-just/':`/prototype/artists/member/?artist=${encodeURIComponent(access.artistId)}`]);
 sections.push({title:'Community pages',text:'Review what visitors see inside this protected test site.',links:communityLinks});
}else{
 sections.push(
  {title:'Artist workspace',text:'Manage Alan’s real profile and artwork. Exhibition and venue examples are for testing.',links:[['Open Alan’s workspace →','/prototype/workspace/'],['Create a showing →','/prototype/workspace/#showing'],['Add artwork →','/prototype/onboarding/artwork/']]},
  {title:'Venue workspace',text:'Apply as a venue, manage venue information, select AAJ members, and prepare invitation previews.',links:[['Open venue intake & workspace →','/prototype/venues/workspace/'],['Manage Leo’s sample venue →','/prototype/venues/workspace/?venue=venue-leos-brewpub']]},
  {title:'Administrator review',text:'Try the application approval, region expansion, and invitation journeys.',links:[['Review artist applications →','/prototype/admin/artists/'],['Review venue applications →','/prototype/admin/venues/'],['Review region proposals →','/prototype/admin/regions/']]},
  {title:'Community pages',text:'See what visitors see, or start a new membership request.',links:[['Join the Community →','/join/'],['Showing Now →','/showing-now/'],['Places to See Art →','/prototype/venues/'],['Alan’s public artist page →','/prototype/artists/alan-just/']]}
 );
}
if(onlineTest)Astro.response.headers.set('Cache-Control','private, no-store');
---
<BaseLayout title={onlineTest?'Your workspaces | Artists Are Jerks':'Prototype workspaces | Artists Are Jerks'} noindex>
<main class="venue-workspace">
 <p>Community expansion · {onlineTest?'Private online test':'Local prototype'}</p>
 <h1>{onlineTest?'Your workspaces':'Workspaces'}</h1>
 <p>{onlineTest?'Open the private workspace assigned to your account or review the community pages.':'Choose a workspace or review the community’s public pages.'}</p>
 {onlineTest&&!isAuthenticated&&<p class="notice">Sign in to open a private artist or venue workspace. <a href="/sign-in/">Sign in →</a></p>}
 {onlineTest&&isAuthenticated&&!access&&<p class="notice">This account does not have an assigned artist or venue workspace yet. An administrator must approve the membership and assign the workspace.</p>}
 {onlineTest&&access&&!access.artistId&&!access.venueId&&!access.administrator&&<p class="notice">This account does not currently have workspace access.</p>}
 {!onlineTest&&<p class="notice">These are local development demonstrations. No email is sent.</p>}
 <div class="public-grid">{sections.map(section=><section class="card"><h2>{section.title}</h2><p>{section.text}</p><ul>{section.links.map(([label,url])=><li><a href={url}>{label}</a></li>)}</ul></section>)}</div>
 {onlineTest&&isAuthenticated&&<p><a href="/account/">View your account access →</a></p>}
 {(!onlineTest||access?.administrator)&&<p><a href="/prototype/storage/">Storage settings &amp; help →</a></p>}
</main>
</BaseLayout>
<style>li{margin-block:.75rem}ul{padding-left:1.25rem}</style>
