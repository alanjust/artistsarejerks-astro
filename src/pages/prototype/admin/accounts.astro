---
export const prerender = false;
import {requireCommunityAccess} from '../../../lib/community-access';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/venue-workspace.css';
const denied = await requireCommunityAccess(Astro, 'administrator');
if (denied) return denied;
const currentUserId = Astro.locals.auth().userId;
---
<BaseLayout title="Account access | Artists Are Jerks" noindex>
<main class="venue-workspace"><p>Administrator</p><h1>Account access</h1><p>Link a signed-in account to an approved artist or venue. Creating an account does not approve membership.</p><p><a href="/account/">Your account →</a></p>
<section class="card"><h2>Assign a workspace</h2><p>In this project’s Clerk dashboard, open Users, select the person, and copy their user ID. They must create their account first.</p>
<form data-account-form data-current-user={currentUserId}>
<label>Clerk user ID<input name="userId" required pattern="user_[a-zA-Z0-9]+" placeholder="user_…" /></label>
<label>Artist workspace<select name="artistId"><option value="">No artist workspace</option></select></label>
<label>Venue workspace<select name="venueId"><option value="">No venue workspace</option></select></label>
<label><input name="administrator" type="checkbox" /> Administrator: can review applications, assign accounts, and manage shared records</label>
<button type="submit" disabled>Save account access</button></form><p data-account-status role="status"></p></section>
<section class="card"><h2>Existing assignments</h2><p>Select an account to review or change its permissions. An artist or venue can have one owner. Your own administrator access cannot be removed here.</p><div class="account-list" data-account-list></div></section>
<p class="notice">Approving an artist or venue in the inbox attaches it to the account that applied, so this page is for special cases. Assigned members can edit their own artist workspace and upload images. Assigned venue owners can edit venue details; approval, visibility, artist lists, and announcement tools remain under administrator control.</p>
</main>
<script>import {initAccountAssignments} from '../../../lib/account-assignments';initAccountAssignments();</script>
</BaseLayout>
<style>
.account-list :global(button) { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-1); width: 100%; margin-bottom: var(--space-2); text-align: left; }
.account-list :global(button span) { font-weight: var(--font-weight-normal); }
.venue-workspace :global(.ownerless) { margin-top: var(--space-6); }
.venue-workspace :global(.ownerless h3) { margin: 0 0 var(--space-1); color: var(--color-gold); }
.venue-workspace :global(.ownerless ul) { margin: var(--space-2) 0 0; }
</style>
