---
export const prerender = false;
import {requireCommunityAccess} from '../../../lib/community-access';
// The old local-prototype review screen is retired. Artist requests are reviewed
// in the shared application inbox, which approves without an acceptance step.
const denied = await requireCommunityAccess(Astro, 'administrator');
if (denied) return denied;
return Astro.redirect('/prototype/admin/inbox/');
