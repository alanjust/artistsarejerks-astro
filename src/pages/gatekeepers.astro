---
import BaseLayout from '../layouts/BaseLayout.astro';

// Every number on this page has a source in the list at the bottom. Add the source before adding a number.
const gates = [
  {stage: 'Growing up', gate: 'Who had art lessons, museum trips, and time to draw.', detail: "Family money is a cushion. In one national survey of arts graduates, White alumni's own earnings made up about 70% of their household income; for Black alumni it was about 80%. Less cushion means less room to take risks.", source: [1]},
  {stage: 'Art school', gate: 'Tuition, debt, and unpaid internships.', detail: "An MFA at Columbia costs $77,840 a year in tuition alone. And debt changes careers: arts graduates who borrowed more than $50,000 are 20% less likely to ever work as artists.", source: [5, 2]},
  {stage: 'Starting out', gate: 'Working for free in cities that cost a fortune.', detail: 'The first few shows matter enormously. A study of half a million artists found that those who start out at prestigious venues tend to stay there, while those who start at the edges face a long climb.', source: [3]},
  {stage: 'Getting a gallery', gate: 'Knowing the right people and being in the right room.', detail: "Galleries mostly find artists through people they already know: other artists, curators, collectors. If you're not in those rooms, you're mostly not in the running."},
  {stage: 'Getting written about', gate: 'Speaking the language critics speak.', detail: "Artist statements and reviews run on an academic vocabulary. If nobody ever taught you to talk that way, it works a lot like a test you didn't know you were taking."},
];

const gatekeepers = [
  {id: 'dealers', pill: 'Dealers', name: 'Gallery owners and dealers', job: 'Decide who gets shown and sold.', how: 'A gallery puts real money into every artist it takes on, so it takes on very few, and mostly through people it already trusts.', who: 'Artists who already know people, and who can afford to live near the galleries.'},
  {id: 'curators', pill: 'Curators', name: 'Museum curators', job: 'Decide what ends up in art history.', how: "A museum show can change a career overnight. Museum boards are often made up of the same collectors who buy from the galleries, so the circle is small.", who: 'Artists who can explain their work in the language of art history and theory.'},
  {id: 'critics', pill: 'Critics', name: 'Critics and journalists', job: 'Decide what gets talked about, and how.', how: "Art writing has its own dialect. It can make the work sound important, and it can make a lot of readers feel shut out.", who: 'Artists whose work fits the conversation critics are already having.'},
  {id: 'collectors', pill: 'Collectors', name: 'Collectors', job: 'Decide what the work is worth.', how: 'At the top, a handful of very rich buyers set prices and trends. In 2025, 39 of the 50 most expensive works sold at auction were sold in New York.', who: "Work that signals taste and holds its value. Whether they love looking at it is a separate question.", source: 4},
  {id: 'schools', pill: 'Art schools', name: 'MFA programs', job: 'Train artists and hand out credentials.', how: 'Tuition is steep and internships are often unpaid. Critiques can assume you grew up knowing the references.', who: 'Students who can afford it, and who already speak the language.', source: 2},
];

const numbers = [
  {figure: '84%', label: 'of US arts graduates surveyed are White', source: 1},
  {figure: '20%', label: 'less likely to ever work as artists, for graduates with $50,000+ in loans', source: 2},
  {figure: '$77,840', label: 'a year in tuition for a Columbia MFA in visual art', source: 5},
  {figure: '39 of 50', label: 'of 2025\'s most expensive auction sales happened in New York', source: 4},
];

const sources = [
  {n: 1, text: 'SNAAP, "Socioeconomic and Racial/Ethnic Exclusion in the Arts"', url: 'https://snaaparts.org/findings/databriefs/socioeconomic-racial-ethnic-exclusion-in-the-arts'},
  {n: 2, text: 'SNAAP, "Arts Bachelor\'s Graduates with $10,000+ in Student Loans Are Less Likely to Work as Artists"', url: 'https://snaaparts.org/findings/databriefs/arts-bachelors-graduates-with-10-000-in-student-loans-are-less-likely-to-work-as-artists-2'},
  {n: 3, text: 'Fraiberger et al., "Quantifying reputation and success in art," Science, 2018', url: 'https://www.science.org/doi/10.1126/science.aau7224'},
  {n: 4, text: 'Art Basel and UBS, The Art Market 2026', url: 'https://www.artbasel.com/stories/the-art-basel-and-ubs-global-art-market-report-2026'},
  {n: 5, text: 'Columbia School of the Arts, Visual Arts tuition, 2025–26', url: 'https://arts.columbia.edu/tuition/visual-arts'},
];
---
<BaseLayout title="Gatekeepers - Artists Are Jerks" bodyClass="gatekeepers-page">
  <div class="gate-page">
    <header class="gate-header">
      <h1>Gatekeepers</h1>
      <p class="lede">Somebody decides which art gets shown, sold, and remembered. That's not an insult. It's a job. But the doors they guard aren't equally easy to reach, and money has a lot to do with who gets there first.</p>
    </header>

    <section class="path-section" aria-labelledby="path-title">
      <h2 id="path-title">An artist's path, and the gates along it</h2>
      <ol class="path">
        {gates.map((gate) => (
          <li class="gate">
            <h3>{gate.stage}</h3>
            <p class="gate-line">{gate.gate}</p>
            <p>{gate.detail}{gate.source?.map((n) => <a class="cite" href={`#source-${n}`} aria-label={`Source ${n}`}>{n}</a>)}</p>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="keepers-title">
      <h2 id="keepers-title">Who's at the gate</h2>
      <div class="pills" role="group" aria-label="Gatekeepers" data-pills hidden>
        {gatekeepers.map((keeper, index) => (
          <button type="button" class="pill" data-keeper={keeper.id} aria-pressed={index === 0 ? 'true' : 'false'}>{keeper.pill}</button>
        ))}
      </div>
      {gatekeepers.map((keeper) => (
        <article class="panel" data-panel={keeper.id}>
          <h3>{keeper.name}</h3>
          <p class="panel-job">{keeper.job}</p>
          <h4>How it works</h4>
          <p>{keeper.how}{keeper.source && <a class="cite" href={`#source-${keeper.source}`} aria-label={`Source ${keeper.source}`}>{keeper.source}</a>}</p>
          <h4>Who gets through</h4>
          <p>{keeper.who}</p>
        </article>
      ))}
    </section>

    <ul class="numbers">
      {numbers.map((item) => (
        <li class="number">
          <strong>{item.figure}</strong>
          <span>{item.label}<a class="cite" href={`#source-${item.source}`} aria-label={`Source ${item.source}`}>{item.source}</a></span>
        </li>
      ))}
    </ul>

    <section class="closing">
      <h2>What this has to do with jerks</h2>
      <p>When there are only a few doors, other artists start to look like competition. Debt makes people anxious. Having to sound sophisticated makes people fake. Feeling like a fraud makes people defensive. Artists aren't jerks by nature. A lot of the time, they're reacting to a system that puts them in impossible spots.</p>
      <h2>The other doors</h2>
      <p>Not everyone waits at the gate. Artist-run spaces, zines, DIY shows, and online platforms build their own networks. They're harder to keep going, but they're real. The artists who do best tend to find other artists to lean on, and learn to talk to institutions without losing their own voice.</p>
      <h2>Related</h2>
      <ul class="related">
        <li><a href="/whats-a-jerk/">What's a Jerk?</a> How these pressures show up as jerk behavior.</li>
        <li><a href="/thinking-like-an-artist/">Thinking Like an Artist</a> What they do to you on the inside.</li>
        <li><a href="/how-art-works/">How Art Works</a> The three jobs art does, and who each one serves.</li>
      </ul>
      <p class="closing-note">None of this excuses bad behavior. But it helps to know where it comes from. What you do with that is up to you.</p>
      <h2 class="sources-title">Sources</h2>
      <ol class="sources">
        {sources.map((source) => <li id={`source-${source.n}`}><a href={source.url} rel="noopener" target="_blank">{source.text}</a></li>)}
      </ol>
    </section>
  </div>

  <script>
    // Without JavaScript every gatekeeper stays visible; with it, the pills show one at a time.
    const pills = document.querySelector<HTMLElement>('[data-pills]');
    const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
    if (pills) {
      pills.hidden = false;
      const show = (id: string) => {
        panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== id; });
        pills.querySelectorAll<HTMLButtonElement>('[data-keeper]').forEach((pill) => pill.setAttribute('aria-pressed', String(pill.dataset.keeper === id)));
      };
      pills.addEventListener('click', (event) => {
        const pill = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-keeper]');
        if (pill?.dataset.keeper) show(pill.dataset.keeper);
      });
      show(panels[0].dataset.panel!);
    }
  </script>

  <style>
    .gate-page { max-width: var(--max-width-text); margin: 0 auto; padding: var(--space-4) 0 var(--space-12); color: var(--color-black); }
    .gate-page h2 { margin: 0 0 var(--space-3); font-family: var(--font-heading); font-size: var(--font-size-2xl); }
    .gate-page p { margin: 0; line-height: var(--line-height-relaxed); }
    .gate-header { margin-bottom: var(--space-6); }
    .gate-header h1 { margin: 0 0 var(--space-2); text-align: center; font-family: var(--font-heading); font-size: var(--font-size-4xl); }
    .lede { max-width: 32rem; margin: 0 auto; font-size: var(--font-size-lg); line-height: var(--line-height-normal); }
    .path-section { margin-bottom: var(--space-8); }
    .path { margin: 0; padding: 0 0 0 var(--space-5); list-style: none; border-left: var(--border-thick) solid var(--color-black); }
    .gate { position: relative; padding-bottom: var(--space-5); }
    .gate:last-child { padding-bottom: 0; }
    .gate::before { content: ''; position: absolute; left: calc(var(--space-5) * -1 - var(--border-thick) / 2 - var(--space-2)); top: var(--space-1); width: var(--space-4); height: var(--space-4); background: var(--color-cream); border: var(--border-base) solid var(--color-black); border-radius: var(--radius-sm); }
    .gate h3 { margin: 0; font-family: var(--font-heading); font-size: var(--font-size-xl); }
    .gate .gate-line { margin-bottom: var(--space-1); font-weight: var(--font-weight-bold); }
    .cite { margin-left: var(--space-1); font-size: var(--font-size-xs); vertical-align: super; color: var(--color-purple); font-weight: var(--font-weight-bold); }
    .panel .cite { color: var(--color-gold); }
    .pills { display: flex; gap: var(--space-2); margin: 0 calc(var(--page-gutter-mobile) * -1) var(--space-4); padding: 0 var(--page-gutter-mobile) var(--space-1); overflow-x: auto; scrollbar-width: none; }
    .pills[hidden] { display: none; }
    .pill { flex: none; min-height: 44px; padding: 0 var(--space-4); background: var(--color-cream); border: 0; border-radius: var(--radius-base); color: var(--color-black); font-family: var(--font-heading); font-size: var(--font-size-base); cursor: pointer; }
    .pill[aria-pressed='true'] { background: var(--color-green); font-weight: var(--font-weight-bold); }
    .pill:focus-visible { outline: var(--border-base) solid var(--color-black); outline-offset: var(--border-base); }
    .panel { margin-bottom: var(--space-4); padding: var(--space-4) var(--space-5); background: var(--color-black); border-radius: var(--radius-lg); color: var(--color-white); }
    .panel[hidden] { display: none; }
    .panel h3 { margin: 0; font-family: var(--font-heading); font-size: var(--font-size-xl); }
    .panel .panel-job { color: var(--color-cream); font-style: italic; }
    .panel h4 { margin: var(--space-3) 0 var(--space-1); font-family: var(--font-heading); font-size: var(--font-size-sm); font-weight: var(--font-weight-bold); letter-spacing: var(--letter-spacing-wider); text-transform: uppercase; color: var(--color-gold); }
    .numbers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); margin: var(--space-6) 0 0; padding: 0; list-style: none; }
    .number { padding: var(--space-3); background: var(--color-cream); border: var(--border-base) solid var(--color-black); border-radius: var(--radius-base); font-size: var(--font-size-sm); line-height: var(--line-height-normal); }
    .number strong { display: block; font-family: var(--font-heading); font-size: var(--font-size-2xl); }
    .closing { margin-top: var(--space-8); padding: var(--space-4) var(--space-5); background: var(--color-cream); border: var(--border-base) solid var(--color-black); border-radius: var(--radius-lg); }
    .closing h2:not(:first-child) { margin-top: var(--space-6); }
    .related, .sources { margin: 0; padding-left: var(--space-5); line-height: var(--line-height-relaxed); }
    .related a, .sources a { color: var(--color-purple); font-weight: var(--font-weight-bold); }
    .closing .closing-note { margin-top: var(--space-4); padding-top: var(--space-3); border-top: var(--border-thin) solid var(--color-black); }
    .closing .sources-title { font-size: var(--font-size-lg); }
    .sources { font-size: var(--font-size-sm); }
    .sources li { scroll-margin-top: var(--space-4); }
    @media (min-width: 900px) {
      .gate-header h1 { font-size: var(--font-size-5xl); }
      .pills { margin-inline: 0; padding-inline: 0; }
      .numbers { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    }
  </style>
</BaseLayout>
