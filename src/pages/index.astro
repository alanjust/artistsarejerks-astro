---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Artists Are Jerks - Studio Entrance" bodyClass="homepage">
  <div class="home-stage">
    <div class="home-viewport">
      <div class="illustration-frame">
      <img 
        src="/images/studio-home.svg" 
        alt="Artists Are Jerks Studio Entrance Wall"
        class="studio-illustration"
      />
      <a class="start-here-link" href="/showing-now/" aria-label="Start Here: explore community art Showing Now"></a>
      <img
        src="/images/studio-home-hover.svg"
        alt=""
        aria-hidden="true"
        class="studio-hover"
      />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Home stage fills the main content area */
  .home-stage {
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    position: relative;
    background: #F5A623;
    margin: 0;
    padding: 0;

    /* Smooth momentum scrolling on touch devices */
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
  }

  /* Viewport container for the SVG */
  .home-viewport {
    height: 100%;
    min-width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    position: relative;
  }

  /* Studio illustration styling - maintain aspect ratio on all devices */
  .studio-illustration {
    height: 100%;
    width: auto;
    max-width: none;
    display: block;
    object-fit: contain;
    object-position: center;
    width: 100%;
    flex-shrink: 0;
  }

  .illustration-frame {
    position: relative;
    height: 100%;
    aspect-ratio: 1440 / 814.8;
    flex: 0 0 auto;
  }

  .start-here-link {
    position: absolute;
    left: 43.4%;
    top: 66.5%;
    width: 13.5%;
    height: 8%;
    min-height: 44px;
  }

  .start-here-link:focus-visible {
    outline: none;
  }

  /* Cream "Start Here" lettering that swaps in over the illustration */
  .studio-hover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .start-here-link:hover ~ .studio-hover,
  .start-here-link:focus-visible ~ .studio-hover {
    opacity: 1;
  }

  /* Ensure smooth horizontal panning */
  .home-stage::-webkit-scrollbar {
    height: 0;
    display: none;
  }

  .home-stage {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  /* Desktop: constrain max width but allow panning */
  @media (min-width: 1440px) {
    .home-viewport {
      width: 1440px;
      margin: 0 auto;
    }
  }
</style>

<script>
  // Center the image on load and on window resize
  function centerImage() {
    const stage = document.querySelector('.home-stage');
    const viewport = document.querySelector('.home-viewport');
    
    if (stage && viewport) {
      // Calculate center position
      const scrollWidth = viewport.scrollWidth;
      const clientWidth = stage.clientWidth;
      const centerPosition = (scrollWidth - clientWidth) / 2;
      
      // Scroll to center
      stage.scrollLeft = centerPosition;
    }
  }

  // Center on load
  window.addEventListener('load', centerImage);
  
  // Recenter on resize
  window.addEventListener('resize', centerImage);
  
  // Also try to center immediately
  centerImage();
</script>
