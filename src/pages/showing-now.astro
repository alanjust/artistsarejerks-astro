---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import BrowserShowings from '../components/community-prototype/BrowserShowings.astro';
import pilot from '../data/community-pilot.json';
import {artistSortKey, regionDay, shortDates, showingStatus, showingTag, type ShowingTag} from '../lib/showing-display';

const onlineTest = import.meta.env.MODE === 'online-test';
// The community lives in the Rogue Valley, so "today" is Pacific time, not the server's clock.
const today = regionDay();
const region = pilot.regions[0];
const regionLabel = region ? `${region.name}, ${region.state}` : 'Rogue Valley, Oregon';

type Card = {id: string; artistId: string | null; image: string; alt: string; name: string; href: string | null; venue: string; city: string; dates: string; tag: ShowingTag | null; sort: string; start: string; search: string; fpo: boolean};

// Local-prototype sample showings. Phase comes from the dates; a fixture with a
// missing artist, venue, or artwork is skipped instead of crashing the page.
const fixtures = (onlineTest ? [] : pilot.exhibitions).flatMap((show) => {
  const dates = {start: show.startDate, end: show.endDate};
  const phase = showingStatus(dates, today);
  const artist = pilot.artists.find((item) => item.id === show.artistId);
  const venue = pilot.venues.find((item) => item.id === show.venueId);
  const artworks = show.artworkIds.map((id) => pilot.artworks.find((work) => work.id === id)).filter((work) => work !== undefined);
  const featured = artworks.find((work) => work.id === show.featuredArtworkId) ?? artworks[0];
  if (show.publicationStatus !== 'published' || phase === 'expired' || !artist || !venue || !featured) return [];
  const card: Card = {
    id: show.id, artistId: artist.id, image: featured.image, alt: featured.title, name: artist.name, href: `/prototype/artists/${artist.slug}/`,
    venue: venue.name, city: venue.city, dates: shortDates(dates, today), tag: showingTag(dates, today), sort: artistSortKey(artist.name), start: show.startDate,
    search: `${artist.name} ${venue.name} ${artist.practice.join(' ')} ${venue.city} ${artworks.map((work) => `${work.title} ${work.medium}`).join(' ')}`.toLowerCase(),
    fpo: false,
  };
  return [{phase, card}];
});

// Clearly labeled sample tiles for the local prototype. Their dates are set
// relative to today so the "Ends…" and "Just opened" tags can be seen working.
const offset = (days: number) => { const date = new Date(`${today}T12:00:00Z`); date.setUTCDate(date.getUTCDate() + days); return date.toISOString().slice(0, 10); };
const sampleDates = [[-30, 3], [-2, 40], [-20, 35], [-45, 20], [-10, 55]];
const sampleCities = ['Ashland', 'Central Point', 'Grants Pass', 'Medford', 'Ashland'];
const featuredIds = new Set(pilot.exhibitions.map((show) => show.featuredArtworkId));
const samples: Card[] = onlineTest ? [] : pilot.artworks.filter((work) => work.archiveStatus === 'active' && !featuredIds.has(work.id)).slice(0, 5).map((work, i) => {
  const dates = {start: offset(sampleDates[i][0]), end: offset(sampleDates[i][1])};
  return {
    id: `fpo-${i}`, artistId: null, image: work.image, alt: 'Placeholder artwork', name: `FPO Artist ${i + 2}`, href: null,
    venue: 'FPO venue', city: sampleCities[i], dates: shortDates(dates, today), tag: showingTag(dates, today), sort: `zzz fpo ${i}`, start: dates.start,
    search: `fpo artist ${work.medium} ${sampleCities[i]}`.toLowerCase(), fpo: true,
  };
});
const current = [...fixtures.filter((item) => item.phase === 'showing-now').map((item) => item.card), ...samples].sort((a, b) => a.sort.localeCompare(b.sort));
const upcoming = fixtures.filter((item) => item.phase === 'upcoming').map((item) => item.card).sort((a, b) => a.start.localeCompare(b.start));
const cities = region?.cities ?? [];
if (onlineTest) Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<BaseLayout title="Showing Now | Artists Are Jerks">
  <div class="directory">
    <header>
      <div class="region-line"><p class="eyebrow">{regionLabel}</p><a class="region-change" href="/showing-now/regions/">(somewhere else?)</a></div>
      <h1>Showing Now</h1>
      <p class="intro">Real art, on real walls, near you. Here’s where to go see it.</p>
    </header>
    <p class="notice"><strong>{onlineTest ? 'Private online test:' : 'Local prototype:'}</strong> {onlineTest ? 'Listings come from records saved in the protected test site. They are not confirmed public exhibitions.' : 'Every showing here is a demonstration. Alan has no confirmed physical showing, and Leo’s Brewpub and Grill is fictional.'}</p>

    <section id="current-showings" aria-labelledby="current-heading">
      <div class="section-heading"><h2 id="current-heading">On view now</h2><p><span class="sort-note">A–Z by artist · </span><span id="result-count" aria-live="polite">{current.length} {current.length === 1 ? 'showing' : 'showings'}</span></p></div>
      <div class="showing-grid">
        {current.map((card, index) => (
          <article class="showing-card" data-show-id={card.id} data-artist-id={card.artistId ?? undefined} data-city={card.city} data-sort={card.sort} data-start={card.start} data-search={card.search}>
            <div class="artwork-frame"><img src={card.image} alt={card.alt} loading={index < 4 ? 'eager' : 'lazy'} />{card.fpo && <span class="fpo">FPO</span>}</div>
            <div class="copy">
              {card.tag && <span class={`showing-tag tag-${card.tag.kind}`}>{card.tag.label}</span>}
              <h3>{card.href ? <a class="card-title" href={card.href}>{card.name}</a> : card.name}</h3>
              <p class="venue-line">{card.venue} · {card.city}</p>
              <p class="dates">{card.dates}</p>
            </div>
          </article>
        ))}
      </div>
      <p id="no-results" class="empty" hidden>Nothing on view matches that. Try another city, or clear the search.</p>
    </section>

    <section class="filters" aria-label="Narrow the list">
      <button type="button" popovertarget="city-popup">City: <span data-city-label>All</span> ▾</button>
      <button type="button" popovertarget="search-popup">Search<span data-search-label></span> ▾</button>
      <div id="city-popup" class="popup" popover><label>City<select id="city"><option value="">All of {region?.name ?? 'the region'}</option>{cities.map((city) => <option value={city}>{city}</option>)}</select></label><button type="button" popovertarget="city-popup" popovertargetaction="hide">Done</button></div>
      <div id="search-popup" class="popup" popover><label>Artist, medium, or place<input id="search" type="search" placeholder="Try “painting” or “Ashland”" /></label><button type="button" popovertarget="search-popup" popovertargetaction="hide">Done</button></div>
    </section>

    <BrowserShowings context="directory"/>

    <section class="coming-section" aria-labelledby="coming-heading" hidden={!upcoming.length}>
      <div class="section-heading"><h2 id="coming-heading">Artists to come</h2><p>Upcoming</p></div>
      <div class="coming-grid">
        {upcoming.map((card) => (
          <article class="showing-card coming-card" data-show-id={card.id} data-artist-id={card.artistId ?? undefined} data-city={card.city} data-sort={card.sort} data-start={card.start} data-search={card.search}>
            <div class="artwork-frame"><img src={card.image} alt={`Preview artwork by ${card.name}`} loading="lazy" /></div>
            <div class="copy">
              {card.tag && <span class={`showing-tag tag-${card.tag.kind}`}>{card.tag.label}</span>}
              <h3><a class="card-title" href={card.href!}>{card.name}</a></h3>
              <p class="venue-line">{card.venue} · {card.city}</p>
              <p class="dates">{card.dates}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <nav class="directory-links" aria-label="More from the community">
      <a href="/our-artists/">Meet all our artists →</a>
      <a href="/join/?kind=artist">Artists: get your work listed here →</a>
    </nav>
    <footer class="directory-footer"><p>An artist’s work appears here during the dates it’s actually on a wall somewhere you can walk up to it.</p><p>Interested in a piece? Contact the artist directly. Artists Are Jerks doesn’t handle sales.</p></footer>
  </div>

  <script>
    // This script never imports the storage modules, so the list and its
    // controls work even while shared data is still loading.
    const city = document.querySelector<HTMLSelectElement>('#city');
    const search = document.querySelector<HTMLInputElement>('#search');
    const currentCards = () => [...document.querySelectorAll<HTMLElement>('.showing-grid .showing-card')];

    // Cards arrive from the server and from saved showings; keep one order.
    function sortCards() {
      for (const [selector, key] of [['.showing-grid', 'sort'], ['.coming-grid', 'start']] as const) {
        const grid = document.querySelector(selector);
        if (!grid) continue;
        [...grid.querySelectorAll<HTMLElement>(':scope > .showing-card')]
          .sort((a, b) => (a.dataset[key] ?? '').localeCompare(b.dataset[key] ?? ''))
          .forEach((card) => grid.append(card));
      }
    }
    // Artists can list showings in any city, so the menu grows to match the cards.
    function syncCityOptions() {
      if (!city) return;
      const known = new Set([...city.options].map((option) => option.value));
      currentCards().map((card) => card.dataset.city ?? '').filter((name) => name && !known.has(name)).forEach((name) => { known.add(name); city.add(new Option(name, name)); });
    }
    function filter() {
      const query = search?.value.trim().toLowerCase() ?? '';
      let count = 0;
      currentCards().forEach((card) => { const match = (!city?.value || card.dataset.city === city.value) && (!query || card.dataset.search?.includes(query)); card.hidden = !match; if (match) count++; });
      const result = document.querySelector('#result-count');
      if (result) result.textContent = `${count} ${count === 1 ? 'showing' : 'showings'}`;
      const empty = document.querySelector<HTMLElement>('#no-results');
      if (empty) empty.hidden = count > 0;
      const cityLabel = document.querySelector('[data-city-label]');
      const searchLabel = document.querySelector('[data-search-label]');
      if (cityLabel) cityLabel.textContent = city?.value || 'All';
      if (searchLabel) searchLabel.textContent = query ? `: ${search?.value.trim()}` : '';
    }
    function refresh() { sortCards(); syncCityOptions(); filter(); }
    window.addEventListener('aaj-showings-updated', refresh); refresh();
    // The controls sit below the list, so bring the list back into view after a change.
    const showList = () => document.querySelector('#current-showings')?.scrollIntoView({block: 'start'});
    city?.addEventListener('change', () => { filter(); showList(); });
    search?.addEventListener('input', filter);
    search?.addEventListener('search', showList);
  </script>
</BaseLayout>

<style>
  /* Phone first; wider screens add columns. Card styles live in BrowserShowings.astro. */
  .directory { width: 100%; min-width: 0; max-width: 1280px; box-sizing: border-box; margin: 0 auto; padding: var(--space-2) var(--space-4) var(--space-16); }
  header { max-width: 850px; }
  .region-line { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--space-2); }
  .eyebrow { margin: 0; color: var(--color-purple-dark); font-family: var(--font-heading); font-size: var(--font-size-sm); font-weight: var(--font-weight-bold); text-transform: uppercase; letter-spacing: var(--letter-spacing-wider); }
  .region-change { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-black); font-size: var(--font-size-base); text-decoration: underline; text-underline-offset: var(--underline-offset); }
  h1 { margin: 0; color: var(--color-purple); font-family: var(--font-display); font-size: clamp(2.75rem, 8vw, 4.8rem); font-weight: var(--font-weight-normal); letter-spacing: var(--letter-spacing-display); line-height: var(--line-height-none); }
  .intro { margin: var(--space-2) 0 0; font-family: var(--font-heading); font-size: var(--font-size-lg); line-height: var(--line-height-normal); }
  .notice { margin: var(--space-4) 0 0; padding: var(--space-2) var(--space-3); border-left: var(--border-thick) solid var(--color-black); background: var(--color-gold); font-size: var(--font-size-xs); }

  .section-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-1) var(--space-4); margin: var(--space-6) 0 var(--space-3); }
  .section-heading h2 { margin: 0; font-size: var(--font-size-2xl); }
  .section-heading p { margin: 0; font-size: var(--font-size-sm); }
  .showing-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-mat); min-width: 0; }
  .coming-grid { display: grid; gap: var(--space-mat); min-width: 0; }
  .coming-section { margin-top: var(--space-4); }
  .empty { margin: var(--space-4) 0 0; padding: var(--space-6); border: var(--border-base) dashed var(--color-black); }

  .filters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); margin-top: var(--space-5); }
  .filters > button, .popup button { min-height: 44px; padding: var(--space-2) var(--space-4); border-radius: var(--radius-base); background: var(--color-purple); color: var(--color-white); font-family: var(--font-heading); font-size: var(--font-size-base); font-weight: var(--font-weight-bold); }
  .filters > button { min-width: 0; overflow-wrap: anywhere; }
  .popup { position: fixed; inset: 25% auto auto 50%; transform: translateX(-50%); width: min(380px, calc(100vw - 2rem)); padding: var(--space-5); border: 0; border-radius: var(--radius-lg); background: var(--color-black); color: var(--color-white); box-shadow: var(--shadow-popup); }
  .popup::backdrop { background: var(--color-backdrop); }
  .popup label { display: grid; gap: var(--space-2); font-weight: var(--font-weight-bold); }
  .popup select, .popup input { min-height: 48px; width: 100%; box-sizing: border-box; padding: var(--space-3); border: 0; border-radius: var(--radius-base); font-size: var(--font-size-base); }
  .popup button { margin-top: var(--space-4); }

  .directory-links { display: flex; flex-direction: column; margin-top: var(--space-8); }
  .directory-links a { display: flex; align-items: center; min-height: 44px; color: var(--color-purple-dark); font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); text-decoration: underline; text-underline-offset: var(--underline-offset); }
  .directory-footer { max-width: var(--max-width-text); margin-top: var(--space-6); font-size: var(--font-size-sm); }

  @media (min-width: 700px) {
    .directory { padding: var(--space-8) clamp(var(--space-6), 4vw, var(--space-10)) var(--space-16); }
    .intro { font-size: var(--font-size-xl); }
    .notice { font-size: var(--font-size-sm); }
    .section-heading { margin-top: var(--space-10); }
    .section-heading h2 { font-size: var(--font-size-3xl); }
    .showing-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
    .coming-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
    .filters { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  }
  @media (min-width: 1100px) { .showing-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
