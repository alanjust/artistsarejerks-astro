---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import BrowserShowings from '../components/community-prototype/BrowserShowings.astro';
import pilot from '../data/community-pilot.json';
import {communityFetch} from '../lib/community-transport';
import {datesLine, regionDay, showingStatus, venueSlug} from '../lib/showing-display';

const onlineTest = import.meta.env.MODE === 'online-test';
// The community lives in the Rogue Valley, so "today" is Pacific time, not the server's clock.
const today = regionDay();

type Card = {id: string; artistId: string | null; image: string; alt: string; name: string; href: string | null; city: string; place: string; placeHref: string | null; dates: string; practice: string; search: string; venueId?: string; fpo: boolean};

// Local-prototype sample showings. Their phase comes from their dates, and any
// fixture with a missing artist, venue, or artwork is skipped instead of crashing the page.
const fixtureCards = (onlineTest ? [] : pilot.exhibitions).flatMap((show) => {
  const phase = showingStatus({start: show.startDate, end: show.endDate}, today);
  const artist = pilot.artists.find((item) => item.id === show.artistId);
  const venue = pilot.venues.find((item) => item.id === show.venueId);
  const artworks = show.artworkIds.map((id) => pilot.artworks.find((work) => work.id === id)).filter((work) => work !== undefined);
  const featured = artworks.find((work) => work.id === show.featuredArtworkId) ?? artworks[0];
  if (show.publicationStatus !== 'published' || phase === 'expired' || !artist || !venue || !featured) return [];
  const practice = artist.practice.join(' / ');
  const card: Card = {
    id: show.id, artistId: artist.id, image: featured.image, alt: featured.title, name: artist.name,
    href: `/prototype/artists/${artist.slug}/`, city: venue.city, place: venue.name,
    placeHref: venue.adminVisibility === 'visible' ? `/prototype/venues/${venueSlug(venue.name)}/` : null,
    dates: datesLine({start: show.startDate, end: show.endDate}, today), practice, venueId: venue.id, fpo: false,
    search: `${artist.name} ${venue.name} ${practice} ${venue.city} ${artworks.map((work) => `${work.title} ${work.medium}`).join(' ')}`.toLowerCase(),
  };
  return [{phase, card}];
});
const currentFixtures = fixtureCards.filter((item) => item.phase === 'showing-now').map((item) => item.card);
const upcomingFixtures = fixtureCards.filter((item) => item.phase === 'upcoming').map((item) => item.card);
const featuredIds = new Set(pilot.exhibitions.map((show) => show.featuredArtworkId));
const placeholderCities = ['Ashland', 'Central Point', 'Grants Pass', 'Medford', 'Ashland'];
const placeholders: Card[] = onlineTest ? [] : pilot.artworks.filter((work) => work.archiveStatus === 'active' && !featuredIds.has(work.id)).slice(0, 5).map((work, i) => ({
  id: `fpo-${i}`, artistId: null, image: work.image, alt: 'Placeholder artwork', name: `FPO Artist ${i + 2}`, href: null,
  city: placeholderCities[i], place: 'FPO Rogue Valley venue', placeHref: null, dates: 'Sample current dates', practice: work.medium, fpo: true,
  search: `fpo artist ${work.medium} ${placeholderCities[i]}`.toLowerCase(),
}));
const cards = [...currentFixtures, ...placeholders];
const cities = pilot.regions[0]?.cities ?? [];

type PublicMember = {id: string; name: string; city: string; practice: string; works: {title: string; imageKey: string; sampleImage?: string}[]};
let publicMembers: PublicMember[] = [];
let membersUnavailable = false;
if (onlineTest) {
  try {
    const response = await communityFetch('/api/community/public/state', {cache: 'no-store'}, Astro.locals);
    if (!response.ok) throw new Error(`Public state unavailable (${response.status})`);
    const body = await response.json() as {records?: {collection: string; payload: PublicMember | null}[]};
    publicMembers = (body.records || []).filter((record) => record.collection === 'artists' && record.payload).map((record) => record.payload!);
  } catch (cause) {
    membersUnavailable = true;
    console.error('Showing Now could not load published member artists.', cause);
  }
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}
const showingArtistIds = new Set(currentFixtures.map((card) => card.artistId));
const lastName = (name: string) => name.split(' ').at(-1) ?? name;
const directoryArtists = pilot.artists
  .filter((member) => member.artistVisibility === 'public' && member.adminVisibility === 'visible' && (!onlineTest || member.id === 'artist-alan-just'))
  .map((member) => ({member, work: pilot.artworks.find((work) => member.artworkIds.includes(work.id) && work.profileVisibility === 'public' && work.archiveStatus === 'active')}))
  .filter((entry) => entry.work !== undefined)
  .sort((a, b) => lastName(a.member.name).localeCompare(lastName(b.member.name)));
---

<BaseLayout title="Showing Now | Artists Are Jerks">
  <div class="directory" data-view="overview">
    <header><p class="eyebrow">Community art · Rogue Valley, Oregon</p><h1 id="community-heading">Showing Now</h1><p class="intro" id="community-intro">Find artwork you can see in person—in restaurants, brewpubs, galleries, and artists’ studios across the valley.</p></header>
    <p><a href="/prototype/venues/">Places to see art →</a> · <a href="/join/">Artists &amp; venues: join the community →</a></p>
    <p class="notice"><strong>{onlineTest ? 'Private online test:' : 'Local prototype:'}</strong> {onlineTest ? 'Listings come from records saved in the protected test site. Test listings do not represent confirmed public exhibitions.' : 'All showings here are demonstrations. Alan has no confirmed physical showing. Leo’s Brewpub and Grill is fictional; other sample artists and venues are for testing.'}</p>

    <nav class="view-bar" aria-label="Community view">
      <button type="button" data-view-choice="overview" aria-pressed="true">Overview</button>
      <button type="button" data-view-choice="showings" aria-pressed="false" aria-controls="showings-panel">Showing Now</button>
      <button type="button" data-view-choice="artists" aria-pressed="false" aria-controls="artists-panel">Our Artists</button>
    </nav>
    <div class="community-layout">
    <section id="showings-panel" aria-labelledby="current-heading">
    <button class="expand-button" type="button" data-view-choice="showings">Expand Showing Now ↗</button>
    <section class="filters" aria-label="Find a showing">
      <button type="button" popovertarget="city-popup" id="city-trigger"><span class="wide-label">City: <span data-city-label>All Rogue Valley</span> ▾</span><span class="compact-label">City ▾</span></button>
      <button type="button" popovertarget="search-popup" id="search-trigger"><span class="wide-label" data-search-label>Search artist, medium, or place ▾</span><span class="compact-label">Search ▾</span></button>
      <div id="city-popup" class="popup" popover><label>City<select id="city"><option value="">All Rogue Valley</option>{cities.map((city) => <option value={city}>{city}</option>)}</select></label><button type="button" popovertarget="city-popup" popovertargetaction="hide">Done</button></div>
      <div id="search-popup" class="popup" popover><label>Artist, medium, or place<input id="search" type="search" placeholder="Search current showings" /></label><button type="button" popovertarget="search-popup" popovertargetaction="hide">Done</button></div>
    </section>

    <div class="results-heading"><h2 id="current-heading" class="sr-only">Current showings</h2><p id="result-count" aria-live="polite">{cards.length} {cards.length === 1 ? 'showing' : 'showings'}</p></div>
    <div class="showing-grid">
      {cards.map((card, index) => (
        <article class="showing-card" data-show-id={card.id} data-artist-id={card.artistId ?? undefined} data-city={card.city} data-search={card.search}>
          <div class="artwork-frame"><img src={card.image} alt={card.alt} loading={index ? 'lazy' : 'eager'} />{card.fpo && <span class="fpo">FPO</span>}</div>
          <div class="copy"><p class="city-label">{card.city} · {card.practice}</p><h3>{card.href ? <a href={card.href}>{card.name}</a> : card.name}</h3><p class="dates">{card.dates}</p><p>{card.placeHref ? <a class="venue-name" href={card.placeHref}>{card.place}</a> : <span class="venue-name">{card.place}</span>}</p>{card.href ? <a class="card-link" href={card.href}>Artist, artwork &amp; visit details →</a> : <span class="card-link disabled">Prototype listing</span>}</div>
        </article>
      ))}
    </div>
    <p id="no-results" class="empty" hidden>No current showings match. Try another city or clear your search.</p>

<BrowserShowings context="directory"/>
    <section class="coming-section" aria-labelledby="coming-heading" hidden={!upcomingFixtures.length}>
      <div class="results-heading"><h2 id="coming-heading">Artists to come</h2><p>Upcoming</p></div>
      <div class="coming-grid">
        {upcomingFixtures.map((card) => (
          <article class="showing-card coming-card" data-show-id={card.id} data-artist-id={card.artistId ?? undefined} data-city={card.city} data-search={card.search}>
            <div class="artwork-frame"><img src={card.image} alt={`Preview artwork by ${card.name}`} loading="lazy" /></div>
            <div class="copy"><p class="city-label">{card.city} · {card.practice}</p><h3><a href={card.href!}>{card.name}</a></h3><p class="dates">{card.dates}</p><p>{card.placeHref ? <a class="venue-name" href={card.placeHref}>{card.place}</a> : <span class="venue-name">{card.place}</span>}</p><a class="card-link" href={card.href!}>Meet {card.name} →</a></div>
          </article>
        ))}
      </div>
    </section>
    </section>
    <aside id="artists-panel" aria-labelledby="artists-heading">
      <div class="artist-panel-heading"><h2 id="artists-heading">Our Artists</h2><button class="expand-button" type="button" data-view-choice="artists">Expand Our Artists ↗</button></div>
      <p class="roster-intro">Meet the community, whether or not their work is showing today.</p>
      <div class="member-grid" data-server-members={onlineTest ? true : undefined}>
        {directoryArtists.map(({member, work}) => (
          <a class="member-card" data-artist-id={member.id} href={`/prototype/artists/${member.slug}/`}><img src={work!.image} alt={`Artwork by ${member.name}`} loading="lazy" /><div><h3>{member.name}</h3><p>{member.homeCity}</p><p>{member.practice.join(' · ')}</p>{showingArtistIds.has(member.id) && <span class="member-status">Showing now</span>}</div></a>
        ))}
        {publicMembers.map((member) => {const work = member.works[0]; if (!work) return null; return <a class="member-card" data-member-profile={member.id} href={`/prototype/artists/member/?artist=${encodeURIComponent(member.id)}`}><img src={work.sampleImage || `/api/community/public/images/${encodeURIComponent(work.imageKey)}`} alt={`Artwork by ${member.name}`} loading="lazy"/><div><h3>{member.name}</h3><p>{member.city}</p><p>{member.practice}</p></div></a>;})}
        {!onlineTest && <article class="member-card member-card-fpo" aria-label="Prototype member artist who is not showing now"><img src="/images/community-pilot/alan-just/paul-missal-portrait.webp" alt="Placeholder artwork for a future member artist" loading="lazy" /><div><h3>FPO member artist</h3><p>Central Point</p><p>Drawing · Not showing now</p></div></article>}
      </div>
      {membersUnavailable && <p class="members-unavailable" role="status">We couldn’t load the rest of the artist list just now. Reload the page to try again.</p>}
    </aside>
    </div>
    <footer class="directory-footer"><p>More artists and places will join this community directory. An artist’s work appears here during the dates of its physical showing.</p><p>Interested in a piece? Contact the artist directly. Artists Are Jerks does not handle sales.</p></footer>
  </div>

  <script>
    // Navigation and filtering must work the moment the page loads. The storage
    // modules wait on the network before they finish loading, so they are
    // imported lazily in loadDirectoryData() and never block these controls.
    const directory = document.querySelector<HTMLElement>('.directory');
    const showingsPanel = document.querySelector<HTMLElement>('#showings-panel');
    const artistsPanel = document.querySelector<HTMLElement>('#artists-panel');
    const viewBar = document.querySelector<HTMLElement>('.view-bar');
    document.querySelectorAll<HTMLButtonElement>('[data-view-choice]').forEach((button) => button.addEventListener('click', () => {
      const view = button.dataset.viewChoice ?? 'overview';
      if (directory) directory.dataset.view = view;
      const heading = document.querySelector('#community-heading');
      const intro = document.querySelector('#community-intro');
      const title = view === 'artists' ? 'Our Artists' : 'Showing Now';
      if (heading) heading.textContent = title;
      if (intro) intro.textContent = view === 'artists'
        ? 'Meet the artists of the Rogue Valley community and explore their work, whether or not they are showing today.'
        : 'Find artwork you can see in person—in restaurants, brewpubs, galleries, and artists’ studios across the valley.';
      document.title = `${title} | Artists Are Jerks`;
      if (showingsPanel) showingsPanel.hidden = view === 'artists';
      if (artistsPanel) artistsPanel.hidden = view === 'showings';
      document.querySelectorAll<HTMLButtonElement>('.view-bar [data-view-choice]').forEach((tab) => tab.setAttribute('aria-pressed', String(tab.dataset.viewChoice === view)));
      viewBar?.scrollIntoView({block: 'start', behavior: 'auto'});
    }));
    const city = document.querySelector<HTMLSelectElement>('#city');
    const search = document.querySelector<HTMLInputElement>('#search');
    const currentCards = () => [...document.querySelectorAll<HTMLElement>('.showing-grid .showing-card')];

    // Artists can list showings in any city, so the menu grows to match the cards.
    function syncCityOptions() {
      if (!city) return;
      const known = new Set([...city.options].map((option) => option.value));
      currentCards().map((card) => card.dataset.city ?? '').filter((name) => name && !known.has(name)).forEach((name) => { known.add(name); city.add(new Option(name, name)); });
    }
    // "Showing now" badges follow the cards actually listed, not a stored flag.
    function markShowingArtists() {
      const showing = new Set(currentCards().map((card) => card.dataset.artistId).filter(Boolean));
      document.querySelectorAll<HTMLElement>('.member-card').forEach((card) => {
        const id = card.dataset.artistId ?? card.dataset.memberProfile;
        const badge = card.querySelector('.member-status');
        if (id && showing.has(id)) {
          if (!badge) { const status = document.createElement('span'); status.className = 'member-status'; status.textContent = 'Showing now'; card.querySelector('div')?.append(status); }
        } else badge?.remove();
      });
    }
    function filter() {
      const query = search?.value.trim().toLowerCase() ?? '';
      let count = 0;
      currentCards().forEach((card) => { const match = (!city?.value || card.dataset.city === city.value) && (!query || card.dataset.search?.includes(query)); card.hidden = !match; if (match) count++; });
      document.querySelector('#result-count')!.textContent = `${count} ${count === 1 ? 'showing' : 'showings'}`;
      document.querySelector<HTMLElement>('#no-results')!.hidden = count > 0;
      const cityLabel = document.querySelector<HTMLElement>('[data-city-label]');
      const searchLabel = document.querySelector<HTMLElement>('[data-search-label]');
      if (cityLabel) cityLabel.textContent = city?.value || 'All Rogue Valley';
      if (searchLabel) searchLabel.textContent = query ? `Search: ${search?.value} ▾` : 'Search artist, medium, or place ▾';
    }
    function refresh() { syncCityOptions(); markShowingArtists(); filter(); }
    window.addEventListener('aaj-showings-updated', refresh); refresh();
    city?.addEventListener('change', filter); search?.addEventListener('input', filter);
    async function loadDirectoryData() {
      try {
        if (document.querySelector('.member-grid')?.hasAttribute('data-server-members')) return;
        const {renderMemberDirectory} = await import('../lib/member-artists');
        await renderMemberDirectory();
        refresh();
      } catch (cause) {
        console.error('Could not refresh supplementary directory details.', cause);
      }
    }
    void loadDirectoryData();
  </script>
</BaseLayout>

<style>
  /* Page layout. Card styles live in BrowserShowings.astro so every page that
     shows a showing card uses one definition. Cards and member tiles that
     scripts add later are reached with .directory :global(...). */
  .directory { width: 100%; min-width: 0; max-width: 1280px; margin: auto; padding: var(--space-10) clamp(var(--space-4), 4vw, var(--space-10)) var(--space-16); }
  header { max-width: 850px; }
  .eyebrow { color: var(--color-purple); font-family: var(--font-heading); font-weight: var(--font-weight-bold); text-transform: uppercase; letter-spacing: var(--letter-spacing-wider); }
  h1 { color: var(--color-pink); font-family: var(--font-display); font-size: clamp(2.5rem, 6vw, 4.8rem); font-weight: var(--font-weight-normal); letter-spacing: var(--letter-spacing-display); line-height: var(--line-height-none); }
  .intro { font-family: var(--font-heading); font-size: var(--font-size-xl); line-height: var(--line-height-comfortable); }
  .notice { margin: var(--space-6) 0; padding: var(--space-3) var(--space-4); border-left: var(--border-thick) solid var(--color-black); background: var(--color-gold); font-size: var(--font-size-sm); }

  .view-bar { position: sticky; top: 0; z-index: var(--z-sticky); display: flex; flex-wrap: wrap; gap: var(--space-2); padding: var(--space-3) 0; margin-bottom: var(--space-5); background: var(--color-stage); border-bottom: var(--border-base) solid var(--color-purple); }
  .view-bar button { min-width: 0; max-width: 100%; min-height: 48px; padding: var(--space-3) var(--space-5); border: var(--border-base) solid var(--color-purple); border-radius: var(--radius-base); color: var(--color-purple); font-family: var(--font-heading); font-weight: var(--font-weight-bold); white-space: normal; }
  .view-bar button[aria-pressed="true"] { background: var(--color-purple); color: var(--color-white); }

  .compact-label { display: none; }
  .filters { display: flex; flex-wrap: wrap; gap: var(--space-3); min-width: 0; }
  .filters button, .popup button { min-height: 44px; padding: var(--space-2) var(--space-4); border-radius: var(--radius-base); background: var(--color-purple); color: var(--color-white); font-family: var(--font-heading); font-weight: var(--font-weight-bold); }
  .filters button { min-width: 0; max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
  .popup { position: fixed; inset: 25% auto auto 50%; transform: translateX(-50%); width: min(380px, calc(100vw - 2rem)); padding: var(--space-5); border: 0; border-radius: var(--radius-lg); background: var(--color-black); color: var(--color-white); box-shadow: var(--shadow-popup); }
  .popup::backdrop { background: var(--color-backdrop); }
  .popup label { display: grid; gap: var(--space-2); font-weight: var(--font-weight-bold); }
  .popup select, .popup input { min-height: 48px; width: 100%; padding: var(--space-3); border: 0; border-radius: var(--radius-base); }
  .popup button { margin-top: var(--space-4); }

  .results-heading { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); margin: var(--space-10) 0 var(--space-5); }
  .results-heading h2 { margin: 0; font-size: var(--font-size-3xl); }
  .showing-grid, .coming-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); min-width: 0; }
  .coming-section { margin-top: var(--space-16); }
  .empty { padding: var(--space-8); border: var(--border-base) dashed var(--color-black); }
  .directory-footer { max-width: var(--max-width-text); margin-top: var(--space-12); font-size: var(--font-size-sm); }

  .community-layout { display: grid; grid-template-columns: minmax(0, 3fr) minmax(240px, 1fr); gap: var(--space-8); align-items: start; min-width: 0; }
  #showings-panel, #artists-panel { min-width: 0; }
  #artists-panel { padding: var(--space-5); background: var(--color-gold); border-radius: var(--radius-lg); }
  #artists-heading { margin-bottom: var(--space-3); font-size: var(--font-size-3xl); }
  .roster-intro { font-size: var(--font-size-sm); }
  .members-unavailable { margin-top: var(--space-4); font-size: var(--font-size-sm); font-weight: var(--font-weight-bold); }
  .expand-button { min-height: 44px; margin-bottom: var(--space-3); color: var(--color-purple); font-weight: var(--font-weight-bold); text-decoration: underline; overflow-wrap: anywhere; }
  .member-grid { display: grid; gap: var(--space-5); min-width: 0; }
  .directory :global(.member-card) { display: grid; grid-template-columns: 70px minmax(0, 1fr); gap: var(--space-3); min-width: 0; padding-bottom: var(--space-4); border-bottom: var(--border-thin) solid var(--color-purple); overflow-wrap: anywhere; }
  .directory :global(.member-card > div) { min-width: 0; }
  .directory :global(.member-card img) { width: 100%; aspect-ratio: 4 / 5; object-fit: contain; border-radius: var(--radius-base); background: var(--color-black); }
  .directory :global(.member-card h3) { font-size: var(--font-size-xl); margin-bottom: var(--space-2); }
  .directory :global(.member-card p) { font-size: var(--font-size-sm); margin-bottom: var(--space-1); }
  .directory :global(.member-status) { display: inline-block; padding: var(--space-1) var(--space-2); margin-top: var(--space-2); border-radius: var(--radius-base); background: var(--color-green); color: var(--color-black); font-size: var(--font-size-xs); font-weight: var(--font-weight-bold); }

  /* Expanded views */
  .directory[data-view="showings"] .community-layout, .directory[data-view="artists"] .community-layout { grid-template-columns: 1fr; }
  .directory[data-view="artists"] .member-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .directory[data-view="artists"] :global(.member-card) { display: flex; flex-direction: column; padding: var(--space-3); border: 0; border-radius: var(--radius-lg); background: var(--color-black); color: var(--color-white); }
  .directory[data-view="artists"] :global(.member-card img) { padding: var(--space-mat); }
  .directory[data-view="artists"] :global(.member-card h3) { margin-top: var(--space-3); }
  .directory[data-view="artists"] #artists-panel { padding: 0; background: transparent; }
  .directory[data-view="artists"] #artists-heading, .directory[data-view="artists"] #artists-panel .expand-button, .directory[data-view="showings"] #showings-panel > .expand-button { display: none; }

  @media (max-width: 950px) { .community-layout { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-4); } }
  @media (max-width: 700px) {
    .directory { padding-top: var(--space-6); }
    .notice { margin: var(--space-4) 0; padding: var(--space-2) var(--space-3); font-size: var(--font-size-xs); }
    #showings-panel > .expand-button { display: none; }
    .showing-grid, .coming-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
    .results-heading { margin: var(--space-5) 0 var(--space-3); font-size: var(--font-size-xs); }
    .results-heading h2 { font-size: var(--font-size-lg); }
    .view-bar { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .view-bar button { width: 100%; padding: var(--space-2); }
    .filters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }
    .filters button { width: 100%; text-align: center; }
    .wide-label { display: none; }
    .compact-label { display: inline; }
    .directory[data-view="artists"] .member-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
    .directory[data-view="overview"] .community-layout { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-mat); }
    .directory[data-view="overview"] .showing-grid, .directory[data-view="overview"] .coming-grid { grid-template-columns: minmax(0, 1fr); }
    .directory[data-view="overview"] #artists-panel { padding: var(--space-2); }
    .directory[data-view="overview"] :global(.member-card) { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); }
    .directory[data-view="overview"] :global(.member-card h3) { font-size: var(--font-size-base); }
    .directory[data-view="overview"] :global(.member-card p) { font-size: var(--font-size-xs); }
    .directory[data-view="overview"] .member-grid { gap: var(--space-4); }
