---
import BaseLayout from '../layouts/BaseLayout.astro';
// Reached from a "Still up?" email. The answer is recorded on a button press, not on
// opening the link, so mail scanners that follow links can't answer for anyone.
---
<BaseLayout title="Still up? | Artists Are Jerks" noindex>
  <main class="still-up-page">
    <h1 data-still-title>Is your work still up?</h1>
    <p data-still-copy>One moment…</p>
    <div class="actions" data-still-actions hidden>
      <button type="button" data-still-answer="yes">Yes, it’s still up</button>
      <button type="button" class="quiet" data-still-answer="down">No, it came down</button>
    </div>
    <p data-still-result role="status"></p>
    <p><a href="/showing-now/">See what’s showing now →</a></p>
  </main>
  <script>
    import {initStillUp} from '../lib/still-up';
    void initStillUp();
  </script>
</BaseLayout>
<style>
  .still-up-page { width: min(640px, 100%); box-sizing: border-box; margin: 0 auto; padding: var(--space-8) var(--space-4) var(--space-16); display: grid; gap: var(--space-4); }
  h1 { margin: 0; color: var(--color-purple); font-family: var(--font-display); font-size: clamp(2.2rem, 7vw, 3.4rem); font-weight: var(--font-weight-normal); letter-spacing: var(--letter-spacing-display); line-height: var(--line-height-tight); }
  p { margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .actions[hidden] { display: none; }
  button { min-height: 48px; padding: var(--space-3) var(--space-5); border: var(--border-base) solid var(--color-purple); border-radius: var(--radius-base); background: var(--color-purple); color: var(--color-white); font-family: var(--font-heading); font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); cursor: pointer; }
  button.quiet { background: none; color: var(--color-purple-dark); }
  a { color: var(--color-purple-dark); font-weight: var(--font-weight-bold); text-decoration: underline; text-underline-offset: var(--underline-offset); }
  [role=status] { font-weight: var(--font-weight-bold); }
</style>
