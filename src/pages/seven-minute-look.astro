---
import BaseLayout from '../layouts/BaseLayout.astro';

// The old Attention Lab, rebuilt as something to do in front of real work.
// Timer approach, dings, and spoken cues come from Alan's Life Drawing Timer web app.
const looks = [
  {name: 'First glance', window: '0:00–0:15', prompt: 'Where does your eye go first?'},
  {name: 'Follow your eye', window: '0:15–3:00', prompt: 'Does the picture move your eye from place to place, or does it drift on its own?'},
  {name: 'Keep finding things', window: '3:00–7:00', prompt: 'Are you still finding things? Stop whenever it stops giving.'},
];

const questions = [
  {q: 'Did it pull you in?', hint: 'What caught you first, and why?'},
  {q: 'Did it keep you?', hint: 'When did you want to walk away, if you did?'},
  {q: 'Did you keep finding things?', hint: 'Name something you only saw after a couple of minutes.'},
  {q: 'Did your eye know where to go?', hint: 'What path did your eye take?'},
  {q: 'Did you move to see it better?', hint: 'Closer, farther, to the side? What changed?'},
  {q: 'Did it stay with you after?', hint: 'Close your eyes. What\'s still there?'},
];
---
<BaseLayout title="The Seven-Minute Look - Artists Are Jerks" bodyClass="seven-look-page">
  <div class="look-page">
    <header class="look-header">
      <h1>The Seven-Minute Look</h1>
      <p class="lede">A guided look you do in person, with a timer. Take it to the next show you visit. Pick one piece, press Start, and find out whether it actually holds your attention, or you just think it should. Artists: try it on your own work before you hang it.</p>
    </header>

    <section class="timer" aria-labelledby="timer-title" data-timer>
      <h2 id="timer-title" class="sr-only">Timer</h2>
      <ol class="looks">
        {looks.map((look, index) => (
          <li class="look" data-look={index}>
            <span class="look-window">{look.window}</span>
            <span class="look-name">{look.name}</span>
            <span class="look-prompt">{look.prompt}</span>
          </li>
        ))}
      </ol>
      <p class="clock" data-clock aria-hidden="true">7:00</p>
      <p class="status" data-status aria-live="polite">Stand in front of one piece. Then press Start.</p>
      <div class="controls">
        <button type="button" class="btn btn--go" data-start>Start the seven minutes</button>
        <button type="button" class="btn" data-done hidden>Done looking</button>
        <button type="button" class="btn btn--quiet" data-stop hidden>Stop</button>
      </div>
      <div class="toggles">
        <label><input type="checkbox" data-sound checked /> Dings</label>
        <label><input type="checkbox" data-voice checked /> Spoken cues</label>
      </div>
      <p class="timer-note">The screen stays on while the timer runs. Turn your volume down in a quiet room.</p>
    </section>

    <section class="questions" id="questions" aria-labelledby="questions-title">
      <h2 id="questions-title">Six questions</h2>
      <p class="rule"><strong>One rule:</strong> write down something you actually saw before you pick a number. Nothing here is saved or sent anywhere.</p>
      <ol class="question-list">
        {questions.map((item, index) => (
          <li class="card">
            <fieldset>
              <legend class="card-title"><span class="card-number" aria-hidden="true">{index + 1}</span>{item.q}</legend>
              <label class="seen-label" for={`seen-${index}`}>What did you see?</label>
              <textarea id={`seen-${index}`} rows="2" placeholder={item.hint}></textarea>
              <p class="score-label" id={`score-${index}`}>Score, 0 to 5</p>
              <div class="scores" role="radiogroup" aria-labelledby={`score-${index}`}>
                {[0, 1, 2, 3, 4, 5].map((n) => (
                  <label class="score"><input type="radio" name={`q${index}`} value={n} data-score /><span>{n}</span></label>
                ))}
              </div>
            </fieldset>
          </li>
        ))}
      </ol>
      <div class="total" aria-live="polite">
        <p class="total-label">Your score</p>
        <p class="total-number"><span data-total>0</span> / 30</p>
        <p data-total-note>Answer all six to see how it did.</p>
        <p class="friend">Better yet, try it with a friend on the same piece. Did you see the same things? When different people notice the same things, that's the work doing it, not your mood.</p>
      </div>
    </section>

    <p class="deeper">Want to see this done slowly, with a lot more eyes on it? <a href="https://hiddengrammarofart.com/corpus" target="_blank" rel="noopener">The Hidden Grammar of Art reads paintings one principle at a time<span class="sr-only"> (opens in a new tab)</span> →</a></p>
  </div>

  <script>
    // Times against end timestamps, so it stays right if the phone dims or the tab is hidden.
    const LOOKS = [
      {end: 15, cue: 'Look. Where does your eye go first?'},
      {end: 180, cue: 'Keep looking. Is the picture moving your eye around, or is your eye drifting on its own?'},
      {end: 420, cue: 'Now go slow. Are you still finding things? Stop whenever it stops giving.'},
    ];
    const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
    const clock = $('[data-clock]'), status = $('[data-status]');
    const startBtn = $<HTMLButtonElement>('[data-start]'), doneBtn = $<HTMLButtonElement>('[data-done]'), stopBtn = $<HTMLButtonElement>('[data-stop]');
    const soundBox = $<HTMLInputElement>('[data-sound]'), voiceBox = $<HTMLInputElement>('[data-voice]');
    const lookRows = [...document.querySelectorAll<HTMLElement>('[data-look]')];

    const dings = {single: new Audio('/sounds/ding_single.wav'), double: new Audio('/sounds/ding_double.wav')};
    Object.values(dings).forEach((el) => { el.preload = 'auto'; });
    function unlockAudio() {
      // iPhone Safari only allows sound after a tap; prime everything from the Start tap.
      Object.values(dings).forEach((el) => { el.muted = true; el.play().then(() => { el.pause(); el.currentTime = 0; el.muted = false; }).catch(() => { el.muted = false; }); });
      try { const u = new SpeechSynthesisUtterance(''); u.volume = 0; speechSynthesis.speak(u); } catch {}
    }
    function ding(which: 'single' | 'double') {
      if (!soundBox.checked) return;
      const el = dings[which]; el.currentTime = 0; el.play().catch(() => {});
    }
    function say(text: string) {
      if (!voiceBox.checked || !('speechSynthesis' in window)) return;
      speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(text); u.rate = 0.95; speechSynthesis.speak(u);
    }

    let wakeLock: WakeLockSentinel | null = null;
    async function holdScreen() { try { if ('wakeLock' in navigator) wakeLock = await navigator.wakeLock.request('screen'); } catch {} }
    function releaseScreen() { wakeLock?.release().catch(() => {}); wakeLock = null; }

    let startedAt = 0, current = -1, timer = 0;
    const fmt = (secs: number) => `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`;

    function enterLook(index: number) {
      current = index;
      lookRows.forEach((row, i) => { row.classList.toggle('is-now', i === index); row.classList.toggle('is-done', i < index); });
      if (index > 0) ding('single');
      say(LOOKS[index].cue);
      status.textContent = LOOKS[index].cue;
      doneBtn.hidden = index !== 2;
    }
    function tick() {
      const elapsed = Math.floor((Date.now() - startedAt) / 1000);
      if (elapsed >= LOOKS[2].end) { finish(); return; }
      const look = LOOKS.findIndex((item) => elapsed < item.end);
      if (look !== current) enterLook(look);
      clock.textContent = fmt(LOOKS[2].end - elapsed);
    }
    function start() {
      unlockAudio();
      holdScreen();
      startedAt = Date.now(); current = -1;
      startBtn.hidden = true; stopBtn.hidden = false;
      ding('single');
      tick();
      timer = window.setInterval(tick, 250);
    }
    function reset(message: string) {
      clearInterval(timer); releaseScreen();
      if ('speechSynthesis' in window) speechSynthesis.cancel();
      current = -1;
      lookRows.forEach((row) => row.classList.remove('is-now', 'is-done'));
      startBtn.hidden = false; doneBtn.hidden = true; stopBtn.hidden = true;
      startBtn.textContent = 'Start again';
      clock.textContent = '7:00';
      status.textContent = message;
    }
    function finish() {
      const secs = Math.floor((Date.now() - startedAt) / 1000);
      ding('double');
      say('Time. Now answer the six questions.');
      reset(`You looked for ${fmt(Math.min(secs, LOOKS[2].end))}. Now answer the six questions below.`);
      lookRows.forEach((row) => row.classList.add('is-done'));
      document.getElementById('questions')!.scrollIntoView({behavior: 'smooth'});
    }
    startBtn.addEventListener('click', start);
    doneBtn.addEventListener('click', finish);
    stopBtn.addEventListener('click', () => reset('Stopped. Press Start when you\'re ready.'));
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible' && current >= 0) { holdScreen(); tick(); } });

    // Running total.
    const totalEl = $('[data-total]'), noteEl = $('[data-total-note]');
    document.querySelector('.question-list')!.addEventListener('change', () => {
      const picked = [...document.querySelectorAll<HTMLInputElement>('[data-score]:checked')];
      const total = picked.reduce((sum, input) => sum + Number(input.value), 0);
      totalEl.textContent = String(total);
      noteEl.textContent = picked.length < 6 ? `${6 - picked.length} to go.`
        : total >= 24 ? 'That piece has a real hold on you.'
        : total >= 15 ? 'It held you some of the way. Which question dropped off?'
        : "It didn't hold you. That's worth knowing too.";
    });
  </script>

  <style>
    .look-page { max-width: var(--max-width-text); margin: 0 auto; padding: var(--space-4) 0 var(--space-12); color: var(--color-black); }
    .look-header { margin-bottom: var(--space-5); }
    .look-header h1 { margin: 0 0 var(--space-2); text-align: center; font-family: var(--font-heading); font-size: var(--font-size-4xl); line-height: var(--line-height-tight); }
    .lede { max-width: 32rem; margin: 0 auto; font-size: var(--font-size-lg); line-height: var(--line-height-normal); }
    .timer { padding: var(--space-4); background: var(--color-black); border-radius: var(--radius-lg); color: var(--color-white); text-align: center; }
    .looks { display: grid; gap: var(--space-2); margin: 0 0 var(--space-3); padding: 0; list-style: none; text-align: left; }
    .look { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 var(--space-3); padding: var(--space-2) var(--space-3); border: var(--border-thin) solid var(--color-gray-700); border-radius: var(--radius-base); }
    .look-window { grid-row: span 2; align-self: center; font-family: var(--font-heading); font-size: var(--font-size-sm); color: var(--color-gold); }
    .look-name { font-family: var(--font-heading); font-weight: var(--font-weight-bold); }
    .look-prompt { font-size: var(--font-size-sm); color: var(--color-gray-300); }
    .look.is-now { background: var(--color-green); border-color: var(--color-green); color: var(--color-black); }
    .look.is-now .look-window, .look.is-now .look-prompt { color: var(--color-black); }
    .look.is-done .look-name { color: var(--color-gray-300); text-decoration: line-through; }
    .clock { margin: var(--space-2) 0 0; font-family: var(--font-heading); font-size: var(--font-size-6xl); line-height: var(--line-height-none); font-variant-numeric: tabular-nums; color: var(--color-gold); }
    .status { min-height: 3em; margin: var(--space-2) 0 var(--space-3); line-height: var(--line-height-normal); }
    .controls { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2); }
    .btn { min-height: 44px; padding: 0 var(--space-5); background: var(--color-cream); border: 0; border-radius: var(--radius-full); color: var(--color-black); font-family: var(--font-heading); font-size: var(--font-size-base); font-weight: var(--font-weight-bold); cursor: pointer; }
    .btn--go { background: var(--color-green); font-size: var(--font-size-lg); }
    .btn--quiet { background: transparent; color: var(--color-white); border: var(--border-thin) solid var(--color-gray-700); }
    .btn:focus-visible { outline: var(--border-base) solid var(--color-gold); outline-offset: var(--border-base); }
    .toggles { display: flex; justify-content: center; gap: var(--space-5); margin-top: var(--space-3); }
    .toggles label { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; }
    .timer-note { margin: var(--space-1) 0 0; font-size: var(--font-size-sm); color: var(--color-gray-300); }
    .questions { margin-top: var(--space-8); scroll-margin-top: var(--space-4); }
    .questions h2 { margin: 0 0 var(--space-2); font-family: var(--font-heading); font-size: var(--font-size-2xl); }
    .rule { margin: 0 0 var(--space-4); line-height: var(--line-height-relaxed); }
    .question-list { display: grid; gap: var(--space-3); margin: 0; padding: 0; list-style: none; }
    .card { padding: var(--space-4) var(--space-5); background: var(--color-cream); border: var(--border-base) solid var(--color-black); border-radius: var(--radius-lg); }
    .card fieldset { margin: 0; padding: 0; border: 0; min-width: 0; }
    .card-title { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3); padding: 0; font-family: var(--font-heading); font-size: var(--font-size-xl); line-height: var(--line-height-tight); }
    .card-number { display: grid; place-items: center; flex: none; width: var(--space-8); height: var(--space-8); border-radius: var(--radius-full); background: var(--color-black); color: var(--color-gold); font-size: var(--font-size-base); }
    .seen-label, .score-label { display: block; margin: 0 0 var(--space-1); font-family: var(--font-heading); font-size: var(--font-size-sm); font-weight: var(--font-weight-bold); color: var(--color-purple); }
    .card textarea { width: 100%; margin-bottom: var(--space-3); padding: var(--space-2); border: var(--border-thin) solid var(--color-black); border-radius: var(--radius-sm); background: var(--color-white); font: inherit; resize: vertical; }
    .scores { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--space-1); }
    .score input { position: absolute; opacity: 0; pointer-events: none; }
    .score span { display: grid; place-items: center; min-height: 44px; border: var(--border-base) solid var(--color-black); border-radius: var(--radius-base); background: var(--color-white); font-family: var(--font-heading); font-weight: var(--font-weight-bold); cursor: pointer; }
    .score input:checked + span { background: var(--color-green); }
    .score input:focus-visible + span { outline: var(--border-base) solid var(--color-purple); outline-offset: var(--border-base); }
    .total { margin-top: var(--space-4); padding: var(--space-4) var(--space-5); background: var(--color-black); border-radius: var(--radius-lg); color: var(--color-white); text-align: center; }
    .total p { margin: 0 0 var(--space-2); line-height: var(--line-height-normal); }
    .total-label { font-family: var(--font-heading); color: var(--color-gold); }
    .total .total-number { margin: 0; font-family: var(--font-heading); font-size: var(--font-size-5xl); line-height: var(--line-height-none); }
    .total .friend { margin: var(--space-3) 0 0; font-size: var(--font-size-sm); color: var(--color-gray-300); }
    .deeper { margin: var(--space-8) 0 0; font-size: var(--font-size-sm); line-height: var(--line-height-relaxed); text-align: center; }
    .deeper a { color: var(--color-purple); }
    @media (min-width: 900px) {
      .look-header h1 { font-size: var(--font-size-5xl); }
      .looks { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
  </style>
</BaseLayout>
