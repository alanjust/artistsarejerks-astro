---
export const prerender = false;
import HiddenGrammarLayout from '../../../layouts/HiddenGrammarLayout.astro';

const { id } = Astro.params;
---

<HiddenGrammarLayout
  title="Artifact Detail"
  description="Full analysis record for a single artifact."
>
  <div class="ad-page hg-page">

    <nav class="ad-back">
      <a href="/hidden-grammar/corpus">← Corpus</a>
    </nav>

    <div id="adContent">
      <p class="ad-loading">Loading…</p>
    </div>

  </div>

  <!-- Similarity modal -->
  <div id="similarModal" class="ad-similar-modal" hidden>
    <div class="ad-similar-modal-inner">
      <div class="ad-similar-modal-header">
        <h2 class="ad-similar-modal-title">Similar Artifacts</h2>
        <button id="similarModalClose" class="ad-modal-close" aria-label="Close">×</button>
      </div>
      <div class="ad-similar-threshold">
        <span class="ad-similar-threshold-label">Min similarity</span>
        <div class="ad-similar-threshold-btns" id="thresholdBtns">
          <button class="ad-threshold-btn ad-threshold-btn--active" data-min="0">All</button>
          <button class="ad-threshold-btn" data-min="70">70%+</button>
          <button class="ad-threshold-btn" data-min="80">80%+</button>
          <button class="ad-threshold-btn" data-min="90">90%+</button>
        </div>
      </div>
      <div id="similarResults" class="ad-similar-results"></div>
    </div>
  </div>

</HiddenGrammarLayout>

<style is:global>
  .ad-page {
    max-width: 860px;
    padding-bottom: 5rem;
  }

  .ad-back {
    margin-bottom: 1.5rem;
  }

  .ad-back a {
    font-size: 0.875rem;
    font-weight: 500;
    color: #64748b;
    text-decoration: none;
  }

  .ad-back a:hover {
    color: #1e293b;
  }

  .ad-loading {
    color: #94a3b8;
    font-size: 0.9375rem;
    margin: 3rem 0;
    text-align: center;
  }

  /* ── Object header ── */
  .ad-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .ad-headline {
    font-size: 1.5rem;
    font-weight: 800;
    color: #1e293b;
    margin: 0 0 0.625rem 0;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .ad-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 0.625rem;
  }

  .ad-badge {
    display: inline-block;
    padding: 0.1875rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .ad-badge--tradition  { background: #eef2ff; color: #4338ca; }
  .ad-badge--reading    { background: #dcfce7; color: #166534; }
  .ad-badge--hypothesis { background: #fef3c7; color: #92400e; }
  .ad-badge--indeterminate { background: #f1f5f9; color: #64748b; }
  .ad-badge--audience   { background: #f0f9ff; color: #0369a1; }
  .ad-badge--mode       { background: #f8fafc; color: #64748b; border: 1px solid #e2e8f0; }
  .ad-badge--function   { background: #fdf4ff; color: #7e22ce; }

  .ad-secondary-meta {
    font-size: 0.8125rem;
    color: #94a3b8;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.375rem;
  }

  /* ── Images ── */
  .ad-images {
    margin-bottom: 2rem;
  }

  .ad-primary-image {
    width: 100%;
    max-width: 480px;
    height: auto;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    display: block;
    margin-bottom: 0.75rem;
  }

  .ad-image-thumbs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .ad-thumb {
    width: 72px;
    height: 72px;
    object-fit: contain;
    border-radius: 6px;
    border: 2px solid #e2e8f0;
    background: #f8fafc;
    cursor: pointer;
    transition: border-color 0.15s;
  }

  .ad-thumb:hover,
  .ad-thumb--active {
    border-color: #4f46e5;
  }

  /* ── Radar ── */
  .ad-radar-section {
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
  }

  .ad-radar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .ad-radar-title {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #94a3b8;
    margin: 0;
  }

  .ad-find-similar-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: none;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.3125rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #4f46e5;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .ad-find-similar-btn:hover {
    background: #eef2ff;
    border-color: #a5b4fc;
  }

  .ad-radar-placeholder {
    text-align: center;
    padding: 2rem 1rem;
    color: #94a3b8;
    font-size: 0.875rem;
    font-style: italic;
  }

  .ad-radar-svg-wrap {
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
  }

  .ad-radar-legend {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.375rem 1.5rem;
  }

  @media (max-width: 560px) {
    .ad-radar-legend {
      grid-template-columns: 1fr;
    }
  }

  .ad-legend-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
  }

  .ad-legend-score {
    display: flex;
    gap: 2px;
    flex-shrink: 0;
  }

  .ad-legend-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e2e8f0;
  }

  .ad-legend-dot--filled-artifact  { background: #4f46e5; }
  .ad-legend-dot--filled-tier-a    { background: #7c3aed; }

  .ad-legend-name {
    color: #334155;
    line-height: 1.3;
  }

  .ad-legend-type {
    font-size: 0.6875rem;
    color: #94a3b8;
    margin-left: auto;
    flex-shrink: 0;
  }

  /* ── Analysis prose ── */
  .ad-section {
    margin-bottom: 2rem;
  }

  .ad-section-heading {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #94a3b8;
    margin: 0 0 0.875rem 0;
  }

  .ad-prose {
    font-size: 0.9375rem;
    color: #1e293b;
    line-height: 1.75;
  }

  :global(.ad-prose h2) {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #4f46e5;
    margin: 2rem 0 0.625rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e2e8f0;
  }

  :global(.ad-prose h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  :global(.ad-prose p) { margin: 0 0 0.875rem; }
  :global(.ad-prose p:last-child) { margin-bottom: 0; }
  :global(.ad-prose ul), :global(.ad-prose ol) { margin: 0 0 1rem; padding-left: 1.25rem; }
  :global(.ad-prose li) { margin-bottom: 0.375rem; line-height: 1.65; }
  :global(.ad-prose strong) { color: #0f172a; font-weight: 600; }

  /* ── Pass 3 block ── */
  .ad-pass3-block {
    border-left: 3px solid #4f46e5;
    padding-left: 1.25rem;
    margin-left: -1.25rem;
    background: #f5f3ff;
    border-radius: 0 10px 10px 0;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }

  /* ── Firings ── */
  .ad-firings-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .ad-firing {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .ad-firing-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .ad-weight {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  .ad-weight--3 { background: #4f46e5; color: #fff; }
  .ad-weight--2 { background: #e2e8f0; color: #475569; }
  .ad-weight--1 { background: #f1f5f9; color: #94a3b8; }

  .ad-firing-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #1e293b;
  }

  .ad-firing-type {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.125rem 0.375rem;
    border-radius: 3px;
  }

  .ad-firing-type--artifact       { background: #eef2ff; color: #4338ca; }
  .ad-firing-type--universal_tier_a { background: #faf5ff; color: #7c3aed; }

  .ad-firing-obs {
    font-size: 0.875rem;
    color: #475569;
    margin: 0;
    padding-left: 1.875rem;
    line-height: 1.5;
  }

  /* ── Collapsibles ── */
  .ad-details {
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .ad-details-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.125rem;
    cursor: pointer;
    user-select: none;
    font-size: 0.875rem;
    font-weight: 600;
    color: #475569;
    list-style: none;
    background: #f8fafc;
  }

  .ad-details-summary::-webkit-details-marker { display: none; }

  .ad-toggle-arrow {
    font-size: 0.875rem;
    color: #94a3b8;
    transition: transform 0.15s;
  }

  details[open] .ad-toggle-arrow { transform: rotate(90deg); }

  .ad-details-body {
    padding: 1.125rem;
    font-size: 0.875rem;
    color: #475569;
    line-height: 1.7;
  }

  /* ── Object metadata ── */
  .ad-meta-grid {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 0.375rem 1rem;
    font-size: 0.875rem;
  }

  .ad-meta-label {
    font-weight: 600;
    color: #94a3b8;
  }

  .ad-meta-value {
    color: #334155;
    word-break: break-word;
  }

  /* ── Compare button (stub) ── */
  .ad-compare-bar {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
  }

  .ad-compare-btn {
    background: #4f46e5;
    color: #fff;
    border: none;
    border-radius: 999px;
    padding: 0.75rem 1.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    box-shadow: 0 4px 16px rgba(79, 70, 229, 0.35);
    transition: background 0.15s, box-shadow 0.15s;
    white-space: nowrap;
  }

  .ad-compare-btn:hover {
    background: #4338ca;
    box-shadow: 0 6px 20px rgba(79, 70, 229, 0.45);
  }

  /* ── RAP flags ── */
  .ad-rap-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .ad-rap-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .ad-rap-type {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1e293b;
  }

  .ad-rap-anchors {
    font-size: 0.8125rem;
    color: #94a3b8;
    margin-left: auto;
  }

  .ad-rap-text {
    font-size: 0.875rem;
    color: #475569;
    margin: 0.25rem 0 0;
    line-height: 1.5;
  }

  /* ── Similarity modal ── */
  .ad-similar-modal {
    position: fixed;
    inset: 0;
    z-index: 300;
    background: rgba(15, 23, 42, 0.6);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow-y: auto;
    padding: 2rem 1rem 4rem;
    backdrop-filter: blur(2px);
  }

  .ad-similar-modal[hidden] {
    display: none;
  }

  .ad-similar-modal-inner {
    background: #ffffff;
    border-radius: 16px;
    width: 100%;
    max-width: 640px;
    padding: 1.75rem 2rem 2rem;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.3);
  }

  .ad-similar-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .ad-similar-modal-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0;
  }

  .ad-modal-close {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid #e2e8f0;
    background: none;
    font-size: 1.25rem;
    line-height: 1;
    color: #94a3b8;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: inherit;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .ad-modal-close:hover {
    background: #f1f5f9;
    color: #1e293b;
  }

  /* ── Threshold controls ── */
  .ad-similar-threshold {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .ad-similar-threshold-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #64748b;
    flex-shrink: 0;
  }

  .ad-similar-threshold-btns {
    display: flex;
    gap: 0.375rem;
  }

  .ad-threshold-btn {
    background: none;
    border: 1px solid #e2e8f0;
    border-radius: 5px;
    padding: 0.25rem 0.625rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #64748b;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.12s ease, border-color 0.12s ease, color 0.12s ease;
  }

  .ad-threshold-btn:hover {
    border-color: #94a3b8;
    color: #1e293b;
  }

  .ad-threshold-btn--active {
    background: #eef2ff;
    border-color: #a5b4fc;
    color: #4338ca;
    font-weight: 600;
  }

  /* ── Similarity results list ── */
  .ad-similar-results {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ad-similar-empty {
    text-align: center;
    padding: 2rem 1rem;
    color: #94a3b8;
    font-size: 0.9375rem;
  }

  .ad-similar-item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .ad-similar-item:hover {
    border-color: #4f46e5;
    box-shadow: 0 2px 8px rgba(79, 70, 229, 0.1);
  }

  .ad-similar-thumb {
    width: 52px;
    height: 52px;
    border-radius: 6px;
    overflow: hidden;
    background: #f1f5f9;
    flex-shrink: 0;
    border: 1px solid #e2e8f0;
  }

  .ad-similar-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ad-similar-thumb-empty {
    width: 100%;
    height: 100%;
    background: #f1f5f9;
  }

  .ad-similar-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .ad-similar-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #1e293b;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ad-similar-meta {
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .ad-similar-score {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
    flex-shrink: 0;
    min-width: 56px;
  }

  .ad-similar-pct {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1;
  }

  .ad-similar-pct--high { color: #059669; }
  .ad-similar-pct--mid  { color: #d97706; }
  .ad-similar-pct--low  { color: #94a3b8; }

  .ad-similar-bar {
    width: 100%;
    height: 4px;
    background: #f1f5f9;
    border-radius: 999px;
    overflow: hidden;
  }

  .ad-similar-bar-fill {
    height: 100%;
    border-radius: 999px;
    background: #4f46e5;
    transition: width 0.3s ease;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .ad-headline { font-size: 1.25rem; }
    .ad-radar-section { padding: 1rem; }
    .ad-pass3-block { margin-left: 0; padding: 1rem 1.25rem; }
    .ad-meta-grid { grid-template-columns: 110px 1fr; }
    .ad-similar-modal-inner { padding: 1.25rem; }
  }
</style>

<script define:vars={{ artifactId: id }}>
  window.__ARTIFACT_ID__ = artifactId;
</script>

<script>
  import { marked } from 'marked';

  const artifactId = (window as any).__ARTIFACT_ID__;

  function esc(s: string | null | undefined): string {
    if (!s) return '';
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function fmt(s: string | null | undefined): string {
    if (!s) return '—';
    return String(s).replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  }

  function fmtDate(s: string): string {
    if (!s) return '';
    const d = new Date(s.replace(' ', 'T') + 'Z');
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  // ── Radar chart ──────────────────────────────────────────────────────────────

  const PRINCIPLES = [
    { key: 'ap_1',  name: 'Production Trace Reading',        type: 'artifact' },
    { key: 'ap_2',  name: 'Sequence Inference',              type: 'artifact' },
    { key: 'ap_3',  name: 'Material Boundary Attention',     type: 'artifact' },
    { key: 'ap_4',  name: 'Wear Differential',               type: 'artifact' },
    { key: 'ap_5',  name: 'Absence as Evidence',             type: 'artifact' },
    { key: 'ap_6',  name: 'Composite Detection',             type: 'artifact' },
    { key: 'ap_7',  name: 'Anatomical Correspondence',       type: 'artifact' },
    { key: 'ap_8',  name: 'Symmetry as Evidence',            type: 'artifact' },
    { key: 'ap_9',  name: 'Proportion as Encoding',          type: 'artifact' },
    { key: 'ap_10', name: 'Color Zone Logic',                type: 'artifact' },
    { key: 'ap_11', name: 'Investment Gradient',             type: 'artifact' },
    { key: 'ap_12', name: 'Attachment Point Reading',        type: 'artifact' },
    { key: 'ap_13', name: 'Orientation Dependency',          type: 'artifact' },
    { key: 'ap_14', name: 'Completion State',                type: 'artifact' },
    { key: 'ap_15', name: 'Reduction vs. Construction',      type: 'artifact' },
    { key: 'ta_1',  name: 'Edge Detection',                  type: 'tier_a' },
    { key: 'ta_2',  name: 'Color Opponent Channels',         type: 'tier_a' },
    { key: 'ta_4',  name: 'Figure-Ground Relationships',     type: 'tier_a' },
    { key: 'ta_5',  name: 'Grouping',                        type: 'tier_a' },
    { key: 'ta_13', name: 'Overlap / Occlusion',             type: 'tier_a' },
    { key: 'ta_15', name: 'Closure / Negative Space',        type: 'tier_a' },
    { key: 'ta_20', name: 'Simultaneous Contrast',           type: 'tier_a' },
    { key: 'ta_28', name: 'Specularity / Surface Reflection', type: 'tier_a' },
    { key: 'ta_47', name: 'Face Detection',                  type: 'tier_a' },
    { key: 'ta_48', name: 'Biological Motion Detection',     type: 'tier_a' },
    { key: 'ta_49', name: 'Gaze Direction / Social Attention', type: 'tier_a' },
    { key: 'ta_51', name: 'Visual Pop-out / Pre-attentive',  type: 'tier_a' },
  ];

  function buildRadar(vector: Record<string, number>): string {
    const cx = 200, cy = 200, r = 160;
    const n = PRINCIPLES.length;
    const toRad = (deg: number) => (deg * Math.PI) / 180;

    function spoke(i: number, radius: number): { x: number; y: number } {
      const angle = toRad((360 / n) * i - 90);
      return { x: cx + radius * Math.cos(angle), y: cy + radius * Math.sin(angle) };
    }

    const ring = (frac: number) => Array.from({ length: n }, (_, i) => spoke(i, r * frac))
      .map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(2)},${p.y.toFixed(2)}`).join(' ') + ' Z';

    const allPoints = PRINCIPLES.map((p, i) => {
      const score = vector[p.key] ?? 0;
      return spoke(i, score === 0 ? 4 : r * (score / 3));
    });

    const polyPath = allPoints
      .map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(2)},${p.y.toFixed(2)}`)
      .join(' ') + ' Z';

    const spokeLines = PRINCIPLES.map((_, i) => {
      const outer = spoke(i, r);
      return `<line x1="${cx}" y1="${cy}" x2="${outer.x.toFixed(2)}" y2="${outer.y.toFixed(2)}" stroke="#e2e8f0" stroke-width="1"/>`;
    }).join('');

    const labelOffset = r + 22;
    const labels = PRINCIPLES.map((p, i) => {
      const pos = spoke(i, labelOffset);
      const anchor = pos.x < cx - 5 ? 'end' : pos.x > cx + 5 ? 'start' : 'middle';
      const shortName = p.name.length > 18 ? p.name.slice(0, 16) + '…' : p.name;
      const color = p.type === 'artifact' ? '#4338ca' : '#7c3aed';
      return `<text x="${pos.x.toFixed(2)}" y="${pos.y.toFixed(2)}" text-anchor="${anchor}" font-size="7.5" fill="${color}" font-family="system-ui,sans-serif" dominant-baseline="middle"><title>${esc(p.name)}</title>${esc(shortName)}</text>`;
    }).join('');

    const dots = PRINCIPLES.map((p, i) => {
      const score = vector[p.key] ?? 0;
      if (score === 0) return '';
      const pos = spoke(i, r * (score / 3));
      const fill = p.type === 'artifact' ? '#4f46e5' : '#7c3aed';
      return `<circle cx="${pos.x.toFixed(2)}" cy="${pos.y.toFixed(2)}" r="3.5" fill="${fill}"/>`;
    }).join('');

    return `<svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Perceptual signature radar chart">
      <path d="${ring(1/3)}" fill="none" stroke="#f1f5f9" stroke-width="1"/>
      <path d="${ring(2/3)}" fill="none" stroke="#e2e8f0" stroke-width="1"/>
      <path d="${ring(1)}"   fill="none" stroke="#cbd5e1" stroke-width="1"/>
      ${spokeLines}
      <path d="${polyPath}" fill="rgba(79,70,229,0.12)" stroke="#4f46e5" stroke-width="1.5" stroke-linejoin="round"/>
      ${dots}
      ${labels}
      <text x="${cx}" y="${cy - r - 8}" text-anchor="middle" font-size="7" fill="#cbd5e1" font-family="system-ui,sans-serif">3</text>
      <text x="${cx}" y="${cy - r * (2/3) - 5}" text-anchor="middle" font-size="7" fill="#cbd5e1" font-family="system-ui,sans-serif">2</text>
      <text x="${cx}" y="${cy - r * (1/3) - 4}" text-anchor="middle" font-size="7" fill="#cbd5e1" font-family="system-ui,sans-serif">1</text>
    </svg>`;
  }

  function buildLegend(vector: Record<string, number>): string {
    return PRINCIPLES.map(p => {
      const score = vector[p.key] ?? 0;
      const color = p.type === 'artifact' ? 'artifact' : 'tier-a';
      const dots = Array.from({ length: 3 }, (_, i) =>
        `<span class="ad-legend-dot${i < score ? ` ad-legend-dot--filled-${color}` : ''}"></span>`
      ).join('');
      return `
        <div class="ad-legend-row">
          <span class="ad-legend-score">${dots}</span>
          <span class="ad-legend-name">${esc(p.name)}</span>
          <span class="ad-legend-type">${p.type === 'artifact' ? 'AP' : 'T-A'}</span>
        </div>`;
    }).join('');
  }

  // ── Main render ──────────────────────────────────────────────────────────────

  async function loadAndRender() {
    const container = document.getElementById('adContent')!;

    let data: any;
    try {
      const res = await fetch(`/api/analysis/${artifactId}`);
      if (!res.ok) throw new Error(`${res.status}`);
      data = await res.json();
    } catch {
      container.innerHTML = `<p class="ad-loading">Failed to load analysis. Please try again.</p>`;
      return;
    }

    const { analysis: a, firings, rap_flags, images, vector } = data;
    if (!a) {
      container.innerHTML = `<p class="ad-loading">Analysis not found.</p>`;
      return;
    }

    const primaryImg = images?.find((img: any) => img.is_primary) || images?.[0];
    const otherImgs  = images?.filter((img: any) => img !== primaryImg) || [];

    const imagesHtml = primaryImg ? `
      <div class="ad-images">
        <img
          id="adPrimaryImg"
          src="/api/image/${esc(primaryImg.storage_url)}"
          alt="${esc(primaryImg.view_label)}"
          class="ad-primary-image"
        />
        ${otherImgs.length > 0 ? `
          <div class="ad-image-thumbs">
            ${[primaryImg, ...otherImgs].map((img: any, i: number) => `
              <img
                src="/api/image/${esc(img.storage_url)}"
                alt="${esc(img.view_label)}"
                class="ad-thumb${i === 0 ? ' ad-thumb--active' : ''}"
                data-src="/api/image/${esc(img.storage_url)}"
                data-label="${esc(img.view_label)}"
              />
            `).join('')}
          </div>
        ` : ''}
      </div>
    ` : '';

    const radarHtml = `
      <div class="ad-radar-section">
        <div class="ad-radar-header">
          <p class="ad-radar-title">Perceptual Signature</p>
          ${vector ? `<button class="ad-find-similar-btn" id="findSimilarBtn">Find similar →</button>` : ''}
        </div>
        ${vector
          ? `<div class="ad-radar-svg-wrap">${buildRadar(vector)}</div>
             <div class="ad-radar-legend">${buildLegend(vector)}</div>`
          : `<p class="ad-radar-placeholder">Perceptual signature not yet available—re-run this analysis to generate it.</p>`
        }
      </div>
    `;

    const pass2Html = a.pass2_text ? `
      <div class="ad-section">
        <h2 class="ad-section-heading">Analysis</h2>
        <div class="ad-prose">${await marked(String(a.pass2_text))}</div>
      </div>
    ` : '';

    const pass3Html = a.pass3_text ? `
      <div class="ad-pass3-block">
        <h2 class="ad-section-heading">What to Take Forward</h2>
        <div class="ad-prose">${await marked(String(a.pass3_text))}</div>
      </div>
    ` : '';

    const firingsHtml = firings?.length > 0 ? `
      <div class="ad-section">
        <h2 class="ad-section-heading">Principles Fired (${firings.length})</h2>
        <div class="ad-firings-list">
          ${firings.map((f: any) => `
            <div class="ad-firing">
              <div class="ad-firing-meta">
                <span class="ad-weight ad-weight--${f.weight}">${f.weight}</span>
                <span class="ad-firing-name">${esc(f.principle_name)}</span>
                <span class="ad-firing-type ad-firing-type--${esc(f.principle_type)}">${f.principle_type === 'artifact' ? 'Artifact' : 'Tier A'}</span>
              </div>
              ${f.observation_text ? `<p class="ad-firing-obs">${esc(f.observation_text)}</p>` : ''}
            </div>
          `).join('')}
        </div>
      </div>
    ` : '';

    const rapHtml = rap_flags?.length > 0 ? `
      <details class="ad-details">
        <summary class="ad-details-summary">
          <span>RAP Flags (${rap_flags.length})</span>
          <span class="ad-toggle-arrow">›</span>
        </summary>
        <div class="ad-details-body">
          <div class="ad-rap-list">
            ${rap_flags.map((r: any) => `
              <div>
                <div class="ad-rap-meta">
                  <span class="ad-badge ad-badge--${esc(r.confidence)}">${esc(r.confidence)}</span>
                  <span class="ad-rap-type">${fmt(r.claim_type)}</span>
                  <span class="ad-rap-anchors">${r.anchor_count} ${r.anchor_count === 1 ? 'anchor' : 'anchors'}</span>
                </div>
                ${r.claim_text ? `<p class="ad-rap-text">${esc(r.claim_text)}</p>` : ''}
              </div>
            `).join('')}
          </div>
        </div>
      </details>
    ` : '';

    const pass1Html = a.pass1_text ? `
      <details class="ad-details">
        <summary class="ad-details-summary">
          <span>Pass 1—Formal Observations</span>
          <span class="ad-toggle-arrow">›</span>
        </summary>
        <div class="ad-details-body ad-prose">${await marked(String(a.pass1_text))}</div>
      </details>
    ` : '';

    const metaFields = [
      ['Accession',  a.accession_number],
      ['Culture',    a.culture],
      ['Period',     a.period_label],
      ['Material',   a.material],
      ['Dimensions', a.dimensions],
      ['Site',       a.site],
      ['Collection', a.collection],
      ['Condition',  a.condition],
      ['Source',     a.source_institution],
    ].filter(([, v]) => v);

    const metaHtml = metaFields.length > 0 ? `
      <details class="ad-details">
        <summary class="ad-details-summary">
          <span>Object Record</span>
          <span class="ad-toggle-arrow">›</span>
        </summary>
        <div class="ad-details-body">
          <dl class="ad-meta-grid">
            ${metaFields.map(([label, value]) => `
              <dt class="ad-meta-label">${esc(String(label))}</dt>
              <dd class="ad-meta-value">${esc(String(value))}</dd>
            `).join('')}
          </dl>
        </div>
      </details>
    ` : '';

    const headline = fmt(a.object_class_identified || a.object_name);
    const subline  = [a.culture, a.period_label].filter(Boolean).join(', ');

    container.innerHTML = `
      <div class="ad-header">
        <h1 class="ad-headline">${esc(headline)}${subline ? `<br><span style="font-size:1rem;font-weight:500;color:#64748b;">${esc(subline)}</span>` : ''}</h1>
        <div class="ad-badges">
          ${a.tradition_identified && a.tradition_identified !== 'unknown'
            ? `<span class="ad-badge ad-badge--tradition">${esc(fmt(a.tradition_identified))}</span>` : ''}
          <span class="ad-badge ad-badge--${esc(a.tradition_confidence)}">${esc(a.tradition_confidence)}</span>
          ${a.function_category && a.function_category !== 'indeterminate'
            ? `<span class="ad-badge ad-badge--function">${esc(fmt(a.function_category))}</span>` : ''}
          <span class="ad-badge ad-badge--audience">${esc(a.audience)}</span>
          <span class="ad-badge ad-badge--mode">${esc(a.analysis_mode)}</span>
        </div>
        <div class="ad-secondary-meta">
          <span>Analyzed ${fmtDate(a.created_at)}</span>
          ${a.temporal_note ? `<span>${esc(a.temporal_note)}</span>` : ''}
        </div>
      </div>

      ${imagesHtml}
      ${radarHtml}
      ${pass2Html}
      ${pass3Html}
      ${firingsHtml}
      ${rapHtml}
      ${pass1Html}
      ${metaHtml}
    `;

    // Thumbnail swap
    container.querySelectorAll<HTMLImageElement>('.ad-thumb').forEach(thumb => {
      thumb.addEventListener('click', () => {
        const primary = document.getElementById('adPrimaryImg') as HTMLImageElement;
        if (primary) { primary.src = thumb.dataset.src || ''; primary.alt = thumb.dataset.label || ''; }
        container.querySelectorAll('.ad-thumb').forEach(t => t.classList.remove('ad-thumb--active'));
        thumb.classList.add('ad-thumb--active');
      });
    });

    // Find similar button
    document.getElementById('findSimilarBtn')?.addEventListener('click', openSimilarModal);
  }

  // ── Similarity search ─────────────────────────────────────────────────────────

  let similarResults: any[] = [];
  let activeThreshold = 0;

  function similarityClass(pct: number): string {
    if (pct >= 90) return 'ad-similar-pct--high';
    if (pct >= 70) return 'ad-similar-pct--mid';
    return 'ad-similar-pct--low';
  }

  function renderSimilarResults() {
    const container = document.getElementById('similarResults')!;
    const filtered  = similarResults.filter(r => r.similarity >= activeThreshold);

    if (filtered.length === 0) {
      const msg = similarResults.length === 0
        ? 'No other artifacts with perceptual signatures yet. Run more analyses to enable similarity search.'
        : `No artifacts at ${activeThreshold}%+ similarity. Try a lower threshold.`;
      container.innerHTML = `<p class="ad-similar-empty">${msg}</p>`;
      return;
    }

    container.innerHTML = filtered.map(r => {
      const name = fmt(r.object_class_identified || r.object_name);
      const meta = [
        r.tradition_identified && r.tradition_identified !== 'unknown' ? fmt(r.tradition_identified) : null,
        r.tradition_confidence,
        r.audience,
      ].filter(Boolean).join(' · ');

      return `
        <a href="/hidden-grammar/corpus/${r.id}"
           class="ad-similar-item"
           target="_blank"
           rel="noopener noreferrer"
           onclick="if(window.innerWidth<1024){this.removeAttribute('target');}"
        >
          <div class="ad-similar-thumb">
            ${r.primary_image_url
              ? `<img src="/api/image/${esc(r.primary_image_url)}" alt="${esc(name)}" loading="lazy" />`
              : '<div class="ad-similar-thumb-empty"></div>'}
          </div>
          <div class="ad-similar-info">
            <span class="ad-similar-name">${esc(name)}</span>
            <span class="ad-similar-meta">${esc(meta)}</span>
          </div>
          <div class="ad-similar-score">
            <span class="ad-similar-pct ${similarityClass(r.similarity)}">${r.similarity}%</span>
            <div class="ad-similar-bar">
              <div class="ad-similar-bar-fill" style="width:${r.similarity}%"></div>
            </div>
          </div>
        </a>
      `;
    }).join('');
  }

  async function openSimilarModal() {
    const modal   = document.getElementById('similarModal')!;
    const content = document.getElementById('similarResults')!;
    modal.hidden  = false;
    document.body.style.overflow = 'hidden';
    content.innerHTML = '<p class="ad-similar-empty">Loading…</p>';

    try {
      const res  = await fetch(`/api/similar/${artifactId}`);
      const data = await res.json();
      if (data.error) throw new Error(data.error);
      similarResults = data.results || [];
      renderSimilarResults();
    } catch {
      content.innerHTML = '<p class="ad-similar-empty">Failed to load similarity data.</p>';
    }
  }

  function closeSimilarModal() {
    document.getElementById('similarModal')!.hidden = true;
    document.body.style.overflow = '';
  }

  document.getElementById('similarModalClose')!.addEventListener('click', closeSimilarModal);

  document.getElementById('similarModal')!.addEventListener('click', e => {
    if (e.target === e.currentTarget) closeSimilarModal();
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeSimilarModal();
  });

  document.getElementById('thresholdBtns')!.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ad-threshold-btn');
    if (!btn) return;
    activeThreshold = parseInt(btn.dataset.min || '0', 10);
    document.querySelectorAll('.ad-threshold-btn').forEach(b => b.classList.remove('ad-threshold-btn--active'));
    btn.classList.add('ad-threshold-btn--active');
    renderSimilarResults();
  });

  loadAndRender();
</script>
