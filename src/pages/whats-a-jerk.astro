---
import BaseLayout from '../layouts/BaseLayout.astro';

const jerkBehaviors = [
  {
    id: 1,
    behavior: '"You just don\'t get it"',
    underneath: "Fear of being misunderstood; insecurity about clarity or exposing weakness.",
    response: '"I\'m genuinely curious—what would make this clearer for me? What part feels most central to you?"'
  },
  {
    id: 2,
    behavior: 'Hiding behind jargon',
    underneath: "Need for credibility; fear being judged superficial; discomfort with emotional aspects.",
    response: '"I see there\'s theory behind this; could you share how you intended people to feel with this work—even a touch?"'
  },
  {
    id: 3,
    behavior: 'The cold shoulder',
    underneath: "Past critique-wounds; protective armor; fear of exposure.",
    response: '"I appreciate you sharing this work. I want to understand what part meant the most to you—what stakes are at work here?"'
  },
  {
    id: 4,
    behavior: 'Bragging',
    underneath: "Masking self-doubt; trying to repel criticism before it lands.",
    response: '"It\'s obvious you\'ve put a lot into this. What worries you most when people critique it?"'
  },
  {
    id: 5,
    behavior: 'Bristling at mild critique',
    underneath: "Identity fused with work; critique feels like personal attack.",
    response: '"I\'m trying to understand—when you hear that feedback, what feels threatening to you?"'
  },
  {
    id: 6,
    behavior: "Mocking people who don't get it",
    underneath: "Distancing/self-protection; avoiding shame by making others wrong.",
    response: '"I might see something different; maybe you can help me see what you meant. What parts do you feel people usually miss?"'
  },
  {
    id: 7,
    behavior: 'Refusing to share',
    underneath: "Exposure feels too risky; fear that visibility = more hurt.",
    response: '"Even if it\'s rough, I value seeing what you\'re exploring. Would you share something small just to feel out how it lands?"'
  },
  {
    id: 8,
    behavior: '"True art must be difficult"',
    underneath: "Fear that emotion = being seen as unserious or sentimental; wanting legitimacy via concept/form; insecurity about emotional impact.",
    response: '"I respect the conceptual depth here. Also, I\'m curious what feeling or mood you hoped someone might take away (if any)—what\'s emotional in this piece for you?"'
  },
  {
    id: 9,
    behavior: 'Sneering at decorative art',
    underneath: "Taste/class anxiety; fear of being judged commercial; conflict between visibility & critical legitimacy.",
    response: '"I like spectacle/decorative art; what do you see in those works that you think others overlook? What do you value most in art?"'
  },
  {
    id: 10,
    behavior: 'Never, ever joking',
    underneath: "Belief that humor or misstep will be used against them; fear of vulnerability via play.",
    response: '"I love when artists joke/let looseness in their work—does this piece have parts you found playful or experiment-y?"'
  },
  {
    id: 11,
    behavior: '"It\'s just a sketch"',
    underneath: "Trying to control criticism; avoid disappointment; protect ego.",
    response: '"What part of this work are you most proud of, even if imperfect? I see something strong here."'
  },
  {
    id: 12,
    behavior: 'Keeping score against peers',
    underneath: "Imposter syndrome; feeling overlooked; belief that success was never possible for them.",
    response: '"I see you doing important work. Can we talk about what milestone matters to you, not someone else\'s yardstick?"'
  }
];
---

<BaseLayout title="What's a Jerk? - Artists Are Jerks" bodyClass="whats-a-jerk-page">
  <div class="jerk-page">
    <header class="jerk-header">
      <h1>What's a Jerk?</h1>
      <p class="lede">You know the type, or you've heard about them: the moody artist in black who looks at you like you've just asked where the bathroom is. So, are artists jerks? Some are. Some are the good kind. And some aren't jerks at all.</p>
    </header>

    <ul class="kinds">
      <li class="kind kind--good"><h2>Good jerks</h2><p>They make you see something you'd have walked right past. They're annoying on purpose, and it's usually worth it.</p><p class="kind-example">The painter whose work bugs you for a week.</p></li>
      <li class="kind kind--bad"><h2>Bad jerks</h2><p>They make you feel dumb so they can feel important. That's the stereotype, and yes, they're real.</p><p class="kind-example">"You wouldn't understand."</p></li>
      <li class="kind kind--normie"><h2>Normies</h2><p>Not jerks at all. They make art you can live with, and they keep it in everyday life. Art needs them more than it admits.</p><p class="kind-example">The landscape over your parents' couch.</p></li>
    </ul>

    <section class="bad-section" aria-labelledby="bad-title">
      <h2 id="bad-title" class="section-title">When an artist is being a bad jerk</h2>
      <p class="section-intro">Twelve things difficult artists do, what's usually going on underneath, and something you can say back.</p>
    <ol class="behaviors">
      {jerkBehaviors.map((item) => (
        <li class="card">
          <h2 class="card-title"><span class="card-number" aria-hidden="true">{item.id}</span>{item.behavior}</h2>
          <h3 class="card-label">What's underneath</h3>
          <p>{item.underneath}</p>
          <h3 class="card-label">Try saying</h3>
          <p class="card-quote">{item.response}</p>
        </li>
      ))}
    </ol>

    </section>

    <aside class="artist-note">
      <h2>If you're an artist</h2>
      <p>And you recognized yourself in a few of these: welcome. So did we. <a href="/thinking-like-an-artist/">Thinking Like an Artist →</a></p>
    </aside>
  </div>

  <style>
    .jerk-page { max-width: var(--max-width-text); margin: 0 auto; padding: var(--space-4) 0 var(--space-12); }
    .jerk-header { text-align: center; margin-bottom: var(--space-6); }
    .jerk-header h1 { margin: 0 0 var(--space-2); font-family: var(--font-heading); font-size: var(--font-size-4xl); color: var(--color-black); }
    .lede { max-width: 32rem; margin: 0 auto; text-align: left; font-size: var(--font-size-lg); line-height: var(--line-height-normal); color: var(--color-black); }
    .behaviors { display: grid; gap: var(--space-4); margin: 0 0 var(--space-4); padding: 0; list-style: none; }
    .card { padding: var(--space-4) var(--space-5); background: var(--color-cream); border: var(--border-base) solid var(--color-black); border-radius: var(--radius-lg); color: var(--color-black); }
    .card p { margin: 0; font-size: var(--font-size-base); line-height: var(--line-height-relaxed); }
    .card p + p { margin-top: var(--space-3); }
    .card-title { display: flex; align-items: center; gap: var(--space-3); margin: 0 0 var(--space-2); font-family: var(--font-heading); font-size: var(--font-size-xl); line-height: var(--line-height-tight); }
    .card-number { display: grid; place-items: center; flex: none; width: var(--space-8); height: var(--space-8); border-radius: var(--radius-full); background: var(--color-black); color: var(--color-gold); font-size: var(--font-size-base); }
    .card-label { margin: var(--space-3) 0 var(--space-1); font-family: var(--font-heading); font-size: var(--font-size-sm); font-weight: var(--font-weight-bold); color: var(--color-purple); }
    .card-quote { font-style: italic; }
    .kinds { display: grid; gap: var(--space-3); margin: 0 0 var(--space-8); padding: 0; list-style: none; }
    .kind { padding: var(--space-4) var(--space-5); border: var(--border-base) solid var(--color-black); border-radius: var(--radius-lg); color: var(--color-black); }
    .kind h2 { margin: 0 0 var(--space-1); font-family: var(--font-heading); font-size: var(--font-size-2xl); }
    .kind p { margin: 0; line-height: var(--line-height-relaxed); }
    .kind .kind-example { margin-top: var(--space-2); font-style: italic; }
    .kind--good { background: var(--color-green); }
    .kind--bad { background: var(--color-plum-red); color: var(--color-white); }
    .kind--normie { background: var(--color-cream); }
    .section-title { margin: 0 0 var(--space-1); font-family: var(--font-heading); font-size: var(--font-size-2xl); }
    .section-intro { margin: 0 0 var(--space-4); line-height: var(--line-height-relaxed); }
    .artist-note { margin-top: var(--space-6); padding: var(--space-4) var(--space-5); background: var(--color-black); border-radius: var(--radius-lg); color: var(--color-white); }
    .artist-note h2 { margin: 0 0 var(--space-1); font-family: var(--font-heading); font-size: var(--font-size-xl); color: var(--color-gold); }
    .artist-note p { margin: 0; line-height: var(--line-height-relaxed); }
    .artist-note a { color: var(--color-gold); font-weight: var(--font-weight-bold); }
    @media (min-width: 900px) {
      .jerk-page { max-width: var(--max-width-content); }
      .jerk-header h1 { font-size: var(--font-size-5xl); }
      .behaviors { grid-template-columns: 1fr 1fr; }
      .kinds { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
  </style>
</BaseLayout>
