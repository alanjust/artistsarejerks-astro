---
// Footer: the fine print, on every page.
const policies = [
    ['Artist Terms', '/artist-terms/'],
    ['Community Guidelines', '/guidelines/'],
    ['Privacy', '/privacy/'],
    ['Site Terms', '/terms/'],
    ['Copyright', '/copyright/'],
];
---

<footer class="site-footer">
    <div class="footer-content">
        <nav class="footer-links" aria-label="The fine print">
            <ul>{policies.map(([name, url]) => <li><a href={url}>{name}</a></li>)}</ul>
        </nav>
        <p class="footer-text">© 2026 Alan Just Design · <span class="footer-brand">Artists Are Jerks · </span><a href="mailto:info@artistsarejerks.com">info@artistsarejerks.com</a></p>
    </div>
</footer>

<style>
    .site-footer { width: 100%; margin: 0; background: var(--color-black); }
    .footer-content { display: flex; flex-direction: column; align-items: center; gap: var(--space-1); max-width: var(--max-width-content); margin: 0 auto; padding: var(--space-2) var(--space-4); box-sizing: border-box; }
    .footer-links ul { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-1) var(--space-4); margin: 0; padding: 0; list-style: none; }
    /* The links sit close together; an invisible margin around each keeps a 44px tap area. */
    .footer-links a { position: relative; display: inline-block; color: var(--color-white); font-family: var(--font-heading); font-size: var(--font-size-sm); line-height: var(--line-height-tight); text-decoration: none; }
    .footer-links a::after { content: ''; position: absolute; inset: calc((44px - 100%) / -2) calc(var(--space-2) * -1); }
    .footer-links a:hover, .footer-links a:focus-visible { color: var(--color-gold); text-decoration: underline; text-underline-offset: var(--underline-offset); }
    .footer-text { margin: 0; color: var(--color-green); font-family: var(--font-heading); font-size: var(--font-size-xs); font-weight: var(--font-weight-bold); line-height: var(--line-height-tight); text-align: center; }
    .footer-text a { color: inherit; }
    /* On phones the site name is already in the header, so the copyright fits on one line. */
    .footer-brand { display: none; }
    /* Wider screens: one line, links on the left and the copyright on the right. */
    @media (min-width: 900px) {
        .footer-content { flex-direction: row; justify-content: space-between; gap: var(--space-6); padding-block: var(--space-2); }
        .footer-links ul { justify-content: flex-start; }
        .footer-text { text-align: right; }
        .footer-brand { display: inline; }
    }
</style>
