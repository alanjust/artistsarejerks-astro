---
// Two parts: See Art (the point of the site) and Artist Tools (the lessons).
type Link = {name: string; url: string; children?: Link[]};
const seeArt: Link[] = [
    {name: 'Showing Now', url: '/showing-now/'},
    {name: 'Places to See Art', url: '/prototype/venues/'},
    {name: 'Our Artists', url: '/our-artists/'},
];
const artistTools: Link[] = [
    {name: "What's a Jerk?", url: '/whats-a-jerk/'},
    {name: 'How Art Works', url: '/how-art-works/'},
    {name: 'Art History Wheel', url: '/art-wheel/', children: [
        {name: 'Movements', url: '/movements/'},
        {name: 'Artists in History', url: '/artists/'},
        {name: 'Benjamin Wheel', url: '/benjamin-wheel/'},
    ]},
    {name: 'Thinking Like an Artist', url: '/thinking-like-an-artist/'},
    {name: 'Gatekeepers', url: '/gatekeepers/'},
];
// The prototype workspaces link is for signed-in testers only. Prerendered pages
// can't know who's signed in, so they leave it out.
let signedIn = false;
if (!Astro.isPrerendered) { try { signedIn = Boolean(Astro.locals.auth?.().isAuthenticated); } catch { signedIn = false; } }
const utility: Link[] = [
    {name: 'Join as an artist or venue', url: '/join/'},
    ...(signedIn ? [{name: 'Workspaces · Prototype', url: '/prototype/workspaces/'}] : []),
    {name: 'Artist sign in', url: '/account/'},
    {name: 'About', url: '/about/'},
];
const path = Astro.url.pathname;
const current = (url: string) => (path === url ? 'page' : undefined);
---

<header class="site-header">
    <div class="header-content">
        <div class="site-title"><a href="/">Artists Are Jerks</a></div>

        <nav class="main-navigation" aria-label="Site">
            <ul class="nav-menu">
                {seeArt.map((link) => <li class="nav-item"><a href={link.url} class="nav-link" aria-current={current(link.url)}>{link.name}</a></li>)}
                {/* Desktop only; on phones the Showing Now page carries the artist invitation. */}
                <li class="nav-item"><a href="/join/?kind=artist" class="nav-link" aria-current={current('/join/')}>For artists</a></li>
            </ul>
        </nav>

        <a href="/showing-now/" class="quick-link" aria-current={current('/showing-now/')}>Showing Now</a>
        <button class="hamburger-menu" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">
            <span class="menu-word" aria-hidden="true">Menu</span>
            <span class="hamburger-icon" aria-hidden="true"><span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span></span>
        </button>
    </div>


    <!-- Desktop only: floats on the page just below the header band, so no page layout shifts. -->
    <nav class="community-access" aria-label="Account">
        <a href="/account/" aria-current={current('/account/')}>Artist sign in</a>
    </nav>

    <div class="mobile-menu" id="site-menu">
        <nav class="menu-panel" aria-label="Site menu">
            <section class="menu-group">
                <h2 class="menu-heading">See Art</h2>
                <p class="menu-note">Where to stand in front of the real thing.</p>
                <ul class="menu-list">
                    {seeArt.map((link) => <li><a href={link.url} class="mobile-nav-link see-art-link" aria-current={current(link.url)}>{link.name}{current(link.url) && <span class="here">You’re here</span>}</a></li>)}
                </ul>
            </section>
            <section class="menu-group">
                <h2 class="menu-heading tools-heading">Artist Tools</h2>
                <p class="menu-note">Short lessons on making, seeing, and showing art.</p>
                <ul class="menu-list">
                    {artistTools.map((link) => (
                        <li>
                            <a href={link.url} class="mobile-nav-link" aria-current={current(link.url)}>{link.name}</a>
                            {link.children && <ul class="menu-children">{link.children.map((child) => <li><a href={child.url} class="mobile-nav-link menu-child" aria-current={current(child.url)}>{child.name}</a></li>)}</ul>}
                        </li>
                    ))}
                </ul>
            </section>
            <ul class="menu-utility">
                {utility.map((link, index) => <li><a href={link.url} class:list={['mobile-nav-link', {'utility-primary': index === 0}]} aria-current={current(link.url)}>{link.name}</a></li>)}
            </ul>
        </nav>
    </div>
</header>

<style>
.site-header { position: relative; z-index: var(--z-header); width: 100%; background: var(--color-purple); border-bottom: var(--header-border) solid var(--color-black); }
.header-content { display: flex; align-items: center; gap: var(--space-2); height: var(--header-height); max-width: var(--max-width-content); margin: 0 auto; padding: 0 var(--space-2) 0 var(--space-4); box-sizing: border-box; }
.site-title { flex-grow: 1; min-width: 0; }
.site-title a { font-family: var(--font-display); font-size: clamp(1.25rem, 3vw, 1.5rem); letter-spacing: var(--letter-spacing-display); color: var(--color-gold); text-decoration: none; white-space: nowrap; }

/* Every size: title, See Art (a Showing Now shortcut on smaller screens), and the menu button. */
.quick-link, .nav-link { display: flex; align-items: center; min-height: 44px; padding: 0 var(--space-2); color: var(--color-gold); font-family: var(--font-heading); font-weight: var(--font-weight-bold); white-space: nowrap; text-decoration: none; }
.quick-link[aria-current], .nav-link[aria-current] { text-decoration: underline; text-underline-offset: var(--underline-offset); }
.nav-link:hover, .quick-link:hover { text-decoration: underline; text-underline-offset: var(--underline-offset); }
.main-navigation { display: none; }
.nav-menu { display: flex; align-items: center; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
.hamburger-menu { display: flex; align-items: center; gap: var(--space-2); min-width: 44px; height: 44px; padding: 0 var(--space-2); background: none; border: 0; color: var(--color-gold); font-family: var(--font-heading); font-size: var(--font-size-base); font-weight: var(--font-weight-bold); cursor: pointer; }
.menu-word { display: none; }
.hamburger-icon { display: flex; flex-direction: column; justify-content: center; gap: var(--space-1); }
.hamburger-line { width: 26px; height: 3px; border-radius: var(--radius-sm); background: var(--color-gold); transition: var(--transition-transform), var(--transition-opacity); }
.hamburger-menu[aria-expanded="true"] .hamburger-line:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.hamburger-menu[aria-expanded="true"] .hamburger-line:nth-child(2) { opacity: 0; }
.hamburger-menu[aria-expanded="true"] .hamburger-line:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
/* Sign in lives in the menu on phones and tablets; desktop also shows it under the header. */
.community-access { display: none; }

/* The menu: full screen on phones, a panel from the right on wider screens. */
.mobile-menu { position: fixed; top: var(--header-height); left: 0; right: 0; bottom: 0; z-index: var(--z-mobile-menu); overflow-y: auto; background: var(--color-black); color: var(--color-white); opacity: 0; visibility: hidden; transition: var(--transition-opacity), visibility var(--duration-base); }
.mobile-menu.active { opacity: 1; visibility: visible; }
.menu-panel { display: flex; flex-direction: column; gap: var(--space-6); max-width: 560px; margin: 0 auto; padding: var(--space-5) var(--space-5) var(--space-8); box-sizing: border-box; }
.menu-heading { margin: 0; color: var(--color-gold); font-family: var(--font-display); font-size: var(--font-size-3xl); font-weight: var(--font-weight-normal); letter-spacing: var(--letter-spacing-display); }
.tools-heading { color: var(--color-green); }
.menu-note { margin: var(--space-1) 0 var(--space-2); color: var(--color-gray-300); font-size: var(--font-size-sm); }
.menu-list, .menu-children, .menu-utility { margin: 0; padding: 0; list-style: none; }
.menu-list > li { border-bottom: var(--border-thin) solid var(--color-gray-700); }
.menu-list > li:last-child { border-bottom: 0; }
.mobile-nav-link { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); min-height: 44px; color: var(--color-white); font-family: var(--font-heading); font-size: var(--font-size-lg); text-decoration: none; }
.see-art-link { min-height: 48px; font-size: var(--font-size-xl); font-weight: var(--font-weight-bold); }
.mobile-nav-link:hover, .mobile-nav-link:focus-visible { color: var(--color-gold); }
.here { color: var(--color-gold); font-size: var(--font-size-xs); font-weight: var(--font-weight-bold); }
.menu-children { display: flex; flex-wrap: wrap; column-gap: var(--space-4); padding: 0 0 var(--space-2) var(--space-4); }
.menu-child { color: var(--color-gray-300); font-size: var(--font-size-sm); }
.menu-utility { display: flex; flex-wrap: wrap; column-gap: var(--space-5); padding-top: var(--space-3); border-top: var(--border-thin) solid var(--color-gray-700); }
.menu-utility .mobile-nav-link { color: var(--color-gray-300); font-size: var(--font-size-sm); }
.menu-utility .utility-primary { color: var(--color-gold); font-weight: var(--font-weight-bold); }

@media (min-width: 700px) {
    .mobile-menu { background: var(--color-backdrop); }
    .menu-panel { width: min(420px, 100%); min-height: 100%; max-width: none; margin: 0 0 0 auto; background: var(--color-black); box-shadow: var(--shadow-xl); }
}
@media (min-width: 1100px) {
    .header-content { padding: 0 clamp(var(--space-4), 4vw, var(--space-8)); }
    .quick-link { display: none; }
    .main-navigation { display: flex; }
    .nav-link { font-size: var(--font-size-lg); }
    .menu-word { display: inline; }
    .community-access { position: absolute; top: calc(100% + var(--header-border)); right: clamp(var(--space-4), 4vw, var(--space-8)); display: flex; font-family: var(--font-heading); font-size: var(--font-size-sm); font-weight: var(--font-weight-bold); }
    .community-access a { display: inline-flex; align-items: center; min-height: 32px; color: var(--color-purple-dark); text-decoration: none; }
    .community-access a:hover, .community-access a:focus-visible, .community-access a[aria-current] { text-decoration: underline; text-underline-offset: var(--underline-offset); }
    /* Pages with the account panel already show who is signed in and a sign-out button. */
    :global(body:has(.account-identity)) .community-access { display: none; }
}
</style>

<script>
const hamburger = document.querySelector<HTMLButtonElement>('.hamburger-menu');
const mobileMenu = document.querySelector<HTMLElement>('.mobile-menu');
if (hamburger && mobileMenu) {
    const setOpen = (open: boolean) => {
        hamburger.setAttribute('aria-expanded', String(open));
        hamburger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        mobileMenu.classList.toggle('active', open);
        document.body.style.overflow = open ? 'hidden' : '';
    };
    hamburger.addEventListener('click', () => setOpen(hamburger.getAttribute('aria-expanded') !== 'true'));
    mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    mobileMenu.addEventListener('click', (event) => { if (event.target === mobileMenu) setOpen(false); });
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && mobileMenu.classList.contains('active')) { setOpen(false); hamburger.focus(); }
    });
}
</script>
