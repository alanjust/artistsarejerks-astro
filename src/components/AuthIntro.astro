---
// The words above the sign-up and sign-in boxes. The two pages look nearly the
// same otherwise, so each says plainly which one you're on and links to the other.
interface Props { mode: 'sign-up' | 'sign-in'; next: string }
const {mode, next} = Astro.props;
// The test site sits behind a separate emailed-code gate; the public site won't.
const onlineTest = import.meta.env.MODE === 'online-test';
const other = mode === 'sign-up' ? `/sign-in/?next=${encodeURIComponent(next)}` : `/sign-up/?next=${encodeURIComponent(next)}`;
---
<div class:list={['auth-intro', mode]}>
  {mode === 'sign-up' ? <>
    <p class="auth-tag">First time here</p>
    <h1>Create your account</h1>
    <p>This is your own Artists Are Jerks account, for putting your art on the site. Make up a password, and save it. You’ll need it every time you come back.</p>
    <p class="auth-switch">Already made an account? <a href={other}>Sign in instead&nbsp;→</a></p>
  </> : <>
    <p class="auth-tag">Coming back</p>
    <h1>Welcome back</h1>
    <p>Sign in with the email and password you made when you joined.{onlineTest && ' Not the code from the test-site gate; that’s a different login.'}</p>
    <p class="auth-switch">First time here? <a href={other}>Create an account instead&nbsp;→</a></p>
  </>}
</div>

<style>
  .auth-intro { width: 100%; max-width: 26rem; margin-bottom: var(--space-5); text-align: center; }
  .auth-tag { display: inline-block; margin: 0 0 var(--space-2); padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); font-family: var(--font-heading); font-size: var(--font-size-sm); font-weight: var(--font-weight-bold); letter-spacing: var(--letter-spacing-wide); text-transform: uppercase; }
  .sign-up .auth-tag { background: var(--color-green); color: var(--color-black); }
  .sign-in .auth-tag { background: var(--color-purple); color: var(--color-white); }
  h1 { margin: 0 0 var(--space-3); color: var(--color-purple); font-family: var(--font-display); font-size: var(--font-size-4xl); font-weight: var(--font-weight-normal); letter-spacing: var(--letter-spacing-display); line-height: var(--line-height-tight); }
  p { margin: 0 0 var(--space-3); line-height: var(--line-height-normal); }
  .auth-switch { font-weight: var(--font-weight-bold); }
  a { color: var(--color-purple-dark); font-weight: var(--font-weight-bold); text-decoration: underline; text-underline-offset: var(--underline-offset); }
</style>
