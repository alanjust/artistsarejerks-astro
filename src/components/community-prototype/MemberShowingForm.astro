---
import pilot from '../../data/community-pilot.json';
const venue=pilot.venues[0];
const onlineTest=import.meta.env.MODE==='online-test';
---
<p class="notice">Saved in prototype storage. No venue notice is sent. Your artist page must be public before a showing can appear publicly.</p><p data-member-showing-status role="status"></p><a data-back-artist-setup href="/prototype/workspaces/">Back to your artist workspace →</a><div data-member-showing-content hidden>
<h3>Your saved showings</h3><p>Edit a saved showing to update its venue, dates, or artwork. Use “Create a showing” only for a new listing.</p>
      <section class="saved-showings" data-saved-showings aria-label="Your saved showings"></section>
      <details class="new-show" data-new-show open><summary>+ Create a showing</summary>
        <p>Choose a place, dates, and the artwork visitors can see there.</p>
        <form id="new-show">
          <div class="form-grid">
            <label class="full">Place<select name="venueId"><option value={venue.id}>{venue.name} · {venue.city}</option><option value="new">+ Add a new venue or studio</option></select></label>
            <fieldset class="full form-grid" data-new-venue hidden><legend>New venue details</legend>
              <label class="full">Venue or studio name<input name="venue" placeholder="Where can people see your work?" maxlength="150"/></label>
              <label class="full">Street address<input name="address" maxlength="250"/><small>Use the visitor entrance address. This will be public.</small></label>
              <label>City<select name="city">{pilot.regions[0].cities.map(city=><option>{city}</option>)}</select></label>
              <label>Venue website <small>optional</small><input name="website" type="url" placeholder="https://"/></label>
            </fieldset>
            <p class="full" data-existing-venue>{venue.addressLine1} · {venue.city}, Oregon</p>
            <label>First day<input name="start" type="text" inputmode="numeric" placeholder="MM/DD/YYYY" aria-label="First day, month/day/year" required/></label><label>Last day<input name="end" type="text" inputmode="numeric" placeholder="MM/DD/YYYY" aria-label="Last day, month/day/year" required/><small>The listing ends after this day, in local time.</small></label>
          </div>
          <fieldset class="simple-checks"><legend>Artwork at this showing</legend><div data-member-showing-works></div></fieldset>
          <label class="representative">Showing Now featured artwork<select name="featuredArtworkId" required><option value="">Select artwork above first</option></select><small>One image represents this showing in the directory. All selected pieces are part of the showing.</small></label>
          <div class="actions"><p data-status="new-show" role="status"></p><button class="button light" type="button" data-save-draft>Save draft</button><button class="button primary">Preview showing →</button></div>
        </form>
        <section class="show-preview" data-show-preview hidden aria-label="Preview showing">
          <p class="eyebrow">Public listing preview</p><div class="preview-card"><img data-preview-image alt=""/><div><h3 data-showing-artist-name></h3><p data-preview-city></p><p data-preview-dates></p><strong data-preview-place></strong><p data-preview-works></p></div></div>
          <p>This place and address will be public. Venue approval is not required. In the live service, the venue would receive a notice.</p>
          <p><strong>{onlineTest?'Private online test:':'Local prototype:'}</strong> {onlineTest?'Publishing updates pages within this protected test site.':'Publishing updates the community’s prototype pages.'}</p>
          <div class="actions"><button class="button light" type="button" data-edit-preview>← Edit showing</button><button class="button primary" type="button" data-publish-show>{onlineTest?'Publish to test site':'Publish to local preview'}</button></div>
        </section>
        <div data-publish-result role="status" hidden><h3>{onlineTest?'Showing published to the protected test site.':'Showing published to your local preview.'}</h3><p>It appears as current or upcoming based on the dates you entered. Expired listings are hidden automatically.</p><div class="published-links"><a href="/showing-now/">Community directory →</a><a data-showing-artist-link href="#">Artist page →</a><a data-published-venue>Venue map &amp; info →</a></div><button type="button" class="button light" data-create-another>Create another showing</button></div>
      </details>

</div><script>import {initMemberShowing} from '../../lib/member-showing';void initMemberShowing();</script>
<style>
.new-show{padding:1.5rem;border-radius:12px;background:#000;color:#fff;margin-block:1.5rem}.new-show [hidden]{display:none!important}.new-show summary{color:var(--color-gold);font-weight:700;font-size:1.25rem}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}.new-show fieldset{margin-block:1.25rem;padding:1rem;border:1px solid #666}.representative{margin-top:1.5rem}.preview-card{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-block:1rem;padding:1rem;background:var(--color-green);color:#000;border-radius:12px}.preview-card img{width:100%;height:280px;object-fit:contain;background:#181818}.published-links{display:flex;flex-wrap:wrap;gap:1rem;margin-block:1.5rem}.saved-showings article{padding:1rem;background:var(--color-gold);border-radius:12px;margin-top:1rem}.saved-showings button{margin:.75rem .75rem 0 0} [data-member-showing-works]{display:grid;gap:.75rem}
@media(max-width:650px){.form-grid,.preview-card{grid-template-columns:1fr}}
</style>
