---
import '../../styles/showing-cards.css';
const { context, artist = '', venue = '' } = Astro.props;
---
<section class="browser-showings" data-browser-showings data-context={context} data-artist={artist} data-venue={venue} hidden aria-label="Published showings"></section>
<script>
  import { VENUES_KEY } from '../../lib/prototype-venues';
  import { renderShowings, SHOWINGS_KEY } from '../../lib/prototype-showings';
  const roots = [...document.querySelectorAll<HTMLElement>('[data-browser-showings]')];
  const refresh = () => roots.forEach(renderShowings);
  refresh();window.addEventListener('storage',e=>{if(e.key===SHOWINGS_KEY||e.key===VENUES_KEY)refresh()});
</script>

