---
// The artist's private workspace: a home that says where things stand, the first
// piece of artwork, the page itself, showings, and profile details.
import MemberShowingForm from './MemberShowingForm.astro';
import pilot from '../../data/community-pilot.json';
import '../../styles/venue-workspace.css';
const {initialArtist = null} = Astro.props;
const onlineTest = import.meta.env.MODE === 'online-test';
const tabs = [['home', 'Home'], ['artwork', 'Artwork'], ['showing', 'Showings'], ['profile', 'Profile'], ['page', 'Your page']];
---
<main class="venue-workspace artist-member-workspace" data-regular-workspace="true" data-initial-artist={initialArtist ? JSON.stringify(initialArtist) : undefined}>
  <p class="workspace-return"><a href="/prototype/workspaces/">← Your workspaces</a></p>
  <p>Private artist workspace · {onlineTest ? 'Online test' : 'Local prototype'}</p>
  <h1 data-setup-title>Your page</h1>
  <p class="notice" data-approval-status hidden></p>
  <p data-setup-message role="status"></p>
  <p data-setup-unavailable hidden>This page opens after you send an artist request. <a href="/join/?kind=artist">Join the community →</a></p>

  <div data-setup-content hidden>
    <nav class="member-tabs" aria-label="Artist workspace">{tabs.map(([value, name]) => <button type="button" data-workspace-tab={value} aria-pressed="false">{name}</button>)}</nav>

    <section class="card home-card" data-panel="home" hidden>
      <h2 data-home-headline></h2>
      <p data-home-detail></p>
      <div class="actions"><button type="button" class="primary-action" data-home-action></button><a data-home-public hidden>View your public page ↗</a></div>
    </section>

    <section class="card" data-panel="artwork" hidden>
      <h2 data-artwork-form-title>Add a piece</h2>
      <p>A clear phone photo is plenty. Show the whole piece, crop out the clutter, and skip the glare.</p>
      <form data-member-upload>
        <label class="drop-zone">
          <input class="sr-only" name="image" type="file" accept="image/jpeg,image/png,image/webp"/>
          <img data-upload-preview alt="Your artwork" hidden/>
          <span class="drop-prompt" data-drop-prompt><strong>Choose a photo of your work</strong><small>JPEG, PNG, or WebP, up to 10 MB</small></span>
        </label>
        <button type="button" class="quiet-button" data-use-sample>Or use a labeled sample image</button>
        <label class="title-field">Title <small>optional</small><input name="title" placeholder="Untitled" maxlength="200"/></label>
        <details class="more-details">
          <summary>More details</summary>
          <div class="fields">
            <label>Medium<input name="medium" maxlength="200" placeholder="Oil on canvas"/></label>
            <label>Year<input name="year" inputmode="numeric" maxlength="4"/></label>
            <label>Availability<select name="sale"><option value="contact">Contact the artist for price</option><option value="price">Show a price</option><option value="private">Price kept private</option><option value="not-for-sale">Not for sale</option><option value="sold">Sold</option></select></label>
            <label data-member-price hidden>Price (USD)<input name="price" type="number" min="0" step="0.01"/></label>
          </div>
          <label class="check"><input name="public" type="checkbox" checked/> Show this piece on my public page</label>
        </details>
        <div class="actions"><button data-save-artwork>Save this piece</button><button type="button" data-cancel-artwork-edit hidden>Cancel</button></div>
        <p data-upload-message role="status"></p>
      </form>
      <div data-artwork-list hidden><h3>Your pieces</h3><div data-member-works></div></div>
    </section>

    <section data-panel="showing" data-workspace-showing hidden><h2>Where your work can be seen</h2><MemberShowingForm/></section>

    <section data-panel="profile" hidden>
      <form class="card" data-setup-profile>
        <h2>About you</h2>
        <div class="fields">
          <label>Artist name<input name="name" required maxlength="150"/></label>
          <label>Home city<input name="city" list="profile-cities" maxlength="120"/><datalist id="profile-cities">{pilot.regions[0]?.cities.map((city) => <option value={city}/>)}</datalist></label>
          <label class="full">What you make<input name="practice" required maxlength="200"/></label>
          <label class="full">Short biography <small>optional</small><textarea name="bio" rows="4" maxlength="2000" placeholder="A few sentences about you and your work"></textarea></label>
        </div>
        <div class="actions"><button>Save</button></div>
      </form>
      <form class="card" data-setup-contact>
        <h2>Contact details</h2>
        <p>Each one stays private unless you choose to show it. Sales stay between you and the buyer.</p>
        <div class="fields">
          <label class="full">Website<input name="website" type="url" placeholder="https://"/></label>
          <label>Email<input name="email" type="email"/></label>
          <label>Phone or text number<input name="phone" type="tel"/></label>
        </div>
        <label class="check"><input name="publicWebsite" type="checkbox"/> Show my website publicly</label>
        <label class="check"><input name="publicEmail" type="checkbox"/> Show my email publicly</label>
        <label class="check"><input name="publicPhone" type="checkbox"/> Show my phone number for calls or texts</label>
        <div class="actions"><button>Save</button></div>
      </form>
    </section>

    <section class="card" data-panel="page" hidden>
      <h2>This is your page</h2>
      <p>Here’s what visitors will see. <a data-member-preview target="_blank" rel="noopener">Open it in a new tab ↗</a></p>
      <iframe class="page-preview" data-page-preview title="Preview of your public page"></iframe>
      <form data-publish-form>
        <fieldset class="reach">
          <legend>How should people reach you?</legend>
          <label class="reach-option"><input type="radio" name="reach" value="website"/><span>Through my website</span></label>
          <label class="reach-website" data-reach-website hidden>Website<input name="website" type="text" inputmode="url" autocapitalize="none" spellcheck="false" placeholder="yourwebsite.com"/></label>
          <label class="reach-option"><input type="radio" name="reach" value="email"/><span>By email, at <span data-reach-email></span></span></label>
          <label class="reach-option"><input type="radio" name="reach" value="none"/><span>Not yet</span></label>
        </fieldset>
        <label class="check" data-rights-field><input name="rights" type="checkbox"/> I made this work, and I have the right to show it.</label>
        <p data-rights-done hidden>You’ve confirmed that you made this work.</p>
        <div class="actions"><button data-publish-member>Publish my page</button><button type="button" data-offline-member hidden>Take my page offline</button><button type="button" data-keep-private>Keep it private for now</button></div>
        <p data-publication-message role="status"></p>
      </form>
      <section class="live-next" data-live-next hidden>
        <h3>You’re live</h3>
        <p>A few good next steps, most important first:</p>
        <div class="actions"><button type="button" data-go="showing">Where can people see your work in person? →</button><button type="button" data-go="artwork">Add another piece</button><button type="button" data-go="profile">Write a short bio</button></div>
      </section>
    </section>
  </div>
</main>
<script>import {initMemberSetup} from '../../lib/member-setup';initMemberSetup();</script>

<style>
  .workspace-return { margin-bottom: var(--space-2); }
  .workspace-return a { font-weight: var(--font-weight-bold); }
  /* Five equal tabs that always fit, even on a phone. */
  .member-tabs { position: sticky; top: 0; z-index: var(--z-sticky); display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin-block: var(--space-6); overflow: hidden; border-radius: var(--radius-base); background: var(--color-black); }
  .member-tabs button { min-width: 0; min-height: 44px; padding: var(--space-2) var(--space-1); border: 0; border-radius: 0; background: var(--color-black); color: var(--color-white); font-size: var(--font-size-sm); line-height: var(--line-height-tight); text-align: center; overflow-wrap: normal; }
  @media (max-width: 560px) { .member-tabs button { font-size: var(--font-size-xs); } }
  .member-tabs button[aria-pressed="true"] { background: var(--color-purple); }
  .home-card h2 { margin-bottom: var(--space-2); }
  .home-card p { font-size: var(--font-size-lg); }
  .home-card .primary-action { background: var(--color-gold); color: var(--color-black); border-color: var(--color-gold); font-weight: var(--font-weight-bold); }
  .home-card a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-gold); }

  .drop-zone { position: relative; display: grid; place-items: center; min-height: 280px; margin-block: var(--space-4) var(--space-2); padding: var(--space-4); border: var(--border-base) dashed var(--color-gray-500); border-radius: var(--radius-lg); background: var(--color-artwork-mat); cursor: pointer; text-align: center; }
  .drop-zone:focus-within { outline: var(--border-thick) solid var(--color-gold); outline-offset: var(--border-base); }
  .drop-zone img { width: 100%; max-height: 420px; object-fit: contain; }
  .drop-prompt { display: grid; gap: var(--space-2); }
  .drop-prompt strong { color: var(--color-gold); font-size: var(--font-size-xl); }
  .drop-prompt small { color: var(--color-gray-300); }
  .quiet-button { min-height: 44px; border: 0 !important; background: none !important; color: var(--color-gray-300) !important; text-decoration: underline; padding-inline: 0 !important; }
  .title-field { margin-top: var(--space-4); }
  .more-details { margin-top: var(--space-4); }
  .more-details summary { min-height: 44px; display: flex; align-items: center; color: var(--color-gold); font-weight: var(--font-weight-bold); cursor: pointer; }
  .more-details .fields { margin-block: var(--space-3); }

  .page-preview { width: 100%; height: 560px; margin-block: var(--space-4); border: 0; border-radius: var(--radius-base); background: var(--color-white); }
  .reach { display: grid; gap: var(--space-1); margin: var(--space-4) 0; padding: 0; border: 0; }
  .reach legend { margin-bottom: var(--space-2); font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); }
  .reach-option { display: flex; align-items: center; gap: var(--space-3); min-height: 44px; font-weight: var(--font-weight-normal); }
  .reach-option input { flex: none; width: 20px; height: 20px; accent-color: var(--color-green); }
  .reach-option span { min-width: 0; overflow-wrap: anywhere; }
  .reach-website { margin-left: var(--space-8); }
  .live-next { margin-top: var(--space-6); padding-top: var(--space-4); border-top: var(--border-thin) solid var(--color-gray-700); }
  .live-next h3 { color: var(--color-gold); font-size: var(--font-size-2xl); }

  :global([data-member-works]) { display: grid; gap: var(--space-4); margin-top: var(--space-4); }
  :global([data-member-works] article) { display: grid; grid-template-columns: minmax(120px, 200px) 1fr; gap: var(--space-4); align-items: start; }
  :global([data-member-works] article > img) { width: 100%; height: 180px; object-fit: contain; border-radius: var(--radius-base); background: var(--color-artwork-mat); }
  @media (max-width: 560px) { :global([data-member-works] article) { grid-template-columns: 1fr; } .page-preview { height: 480px; } }
</style>
