---
// The artist's private workspace: a home that says where things stand, the first
// piece of artwork, the page itself, showings, and profile details.
import '../../styles/showing-cards.css';
import '../../styles/moderation.css';
import pilot from '../../data/community-pilot.json';
import '../../styles/venue-workspace.css';
const {initialArtist = null} = Astro.props;
const onlineTest = import.meta.env.MODE === 'online-test';
const tabs = [['home', 'Home'], ['artwork', 'Artwork'], ['showing', 'Showings'], ['messages', 'Messages'], ['profile', 'Profile'], ['page', 'Your page']];
---
<main class="venue-workspace artist-member-workspace" data-regular-workspace="true" data-initial-artist={initialArtist ? JSON.stringify(initialArtist) : undefined}>
  <p class="workspace-return"><a href="/prototype/workspaces/">← Your workspaces</a></p>
  <p>Private artist workspace · {onlineTest ? 'Online test' : 'Local prototype'}</p>
  <h1 data-setup-title>Your page</h1>
  <p class="notice" data-approval-status hidden></p>
  <p data-setup-message role="status"></p>
  <p data-setup-unavailable hidden>This page opens after you send an artist request. <a href="/join/?kind=artist">Join the community →</a></p>

  <div data-setup-content hidden>
    <nav class="member-tabs" aria-label="Artist workspace">{tabs.map(([value, name]) => <button type="button" data-workspace-tab={value} aria-pressed="false">{name}</button>)}</nav>

    <section class="card home-card" data-panel="home" hidden>
      <h2 data-home-headline></h2>
      <p data-home-detail></p>
      <div class="actions"><button type="button" class="primary-action" data-home-action></button><a data-home-public hidden>View your public page ↗</a></div>
    </section>

    <section class="card" data-panel="artwork" hidden>
      <h2 data-artwork-form-title>Add a piece</h2>
      <p>A clear phone photo is plenty. Show the whole piece, crop out the clutter, and skip the glare.</p>
      <form data-member-upload>
        <label class="drop-zone">
          <input class="sr-only" name="image" type="file" accept="image/jpeg,image/png,image/webp"/>
          <img data-upload-preview alt="Your artwork" hidden/>
          <span class="drop-prompt" data-drop-prompt><strong>Choose a photo of your work</strong><small>JPEG, PNG, or WebP, up to 10 MB</small></span>
        </label>
        <button type="button" class="quiet-button" data-use-sample>Or use a labeled sample image</button>
        <label class="title-field">Title <small>optional</small><input name="title" placeholder="Untitled" maxlength="200"/></label>
        <label class="check ai-check"><input name="madeWithAI" type="checkbox"/> <span>Made with AI <small>AI images are welcome here. This adds a small “Made with AI” label wherever the piece appears.</small></span></label>
        <details class="more-details">
          <summary>More details</summary>
          <div class="fields">
            <label>Medium<input name="medium" maxlength="200" placeholder="Oil on canvas"/></label>
            <label>Year<input name="year" inputmode="numeric" maxlength="4"/></label>
            <label>Availability<select name="sale"><option value="contact">Contact the artist for price</option><option value="price">Show a price</option><option value="private">Price kept private</option><option value="not-for-sale">Not for sale</option><option value="sold">Sold</option></select></label>
            <label data-member-price hidden>Price (USD)<input name="price" type="number" min="0" step="0.01"/></label>
          </div>
          <label class="check"><input name="public" type="checkbox" checked/> Show this piece on my public page</label>
        </details>
        <div class="actions"><button data-save-artwork>Save this piece</button><button type="button" data-cancel-artwork-edit hidden>Cancel</button></div>
        <p data-upload-message role="status"></p>
      </form>
      <div data-artwork-list hidden><h3>Your pieces</h3><p class="hint" data-works-count></p><div data-member-works></div></div>
    </section>

    <section class="card" data-panel="showing" hidden>
      <h2>Where can people see your work?</h2>
      <p data-showings-intro>List each place your work is hanging, so people can go see it in person.</p>
      <div class="saved-showings" data-showings-list></div>
      <div class="actions"><button type="button" data-new-showing>+ Add a showing</button></div>

      <form class="showing-form" data-showing-form hidden novalidate>
        <h3 data-showing-form-title>Add a showing</h3>
        <fieldset>
          <legend>1. Where?</legend>
          <div data-place-picker>
            <label>Find the place<input type="search" data-place-search placeholder="Name or city" autocomplete="off"/></label>
            <div class="place-results" data-place-results></div>
            <button type="button" class="quiet-button" data-place-new>It’s somewhere new</button>
          </div>
          <p class="place-chosen" data-place-chosen hidden><span data-place-label></span> <button type="button" class="quiet-button" data-place-change>Change</button></p>
          <div class="fields" data-new-place hidden>
            <label class="full">Name of the place<input name="venue" maxlength="150" placeholder="Café, gallery, studio…"/></label>
            <label class="full">Street address<input name="address" maxlength="250" autocomplete="street-address"/><small>The entrance visitors use. This will be public.</small></label>
            <label>City<input name="city" maxlength="120" list="showing-cities"/><datalist id="showing-cities">{pilot.regions[0]?.cities.map((city) => <option value={city}/>)}</datalist></label>
            <label>Website <small>optional</small><input name="website" type="text" inputmode="url" autocapitalize="none" spellcheck="false" placeholder="theirwebsite.com"/></label>
          </div>
        </fieldset>
        <fieldset>
          <legend>2. When?</legend>
          <label class="reach-option"><input type="radio" name="when" value="dates" checked/><span>Between two dates</span></label>
          <div class="fields" data-date-fields>
            <label>First day<input name="start" type="date"/></label>
            <label>Last day<input name="end" type="date"/></label>
          </div>
          <label class="reach-option"><input type="radio" name="when" value="ongoing"/><span>Ongoing, like a studio or a long-term wall</span></label>
          <p class="hint" data-ongoing-note hidden>Every couple of months we’ll ask you to confirm it’s still up, so the listing stays true.</p>
        </fieldset>
        <fieldset>
          <legend>3. Which pieces are there?</legend>
          <p class="hint">Tap each piece that’s hanging there. The one with the star represents the showing on Showing Now.</p>
          <div class="piece-picker" data-piece-picker></div>
        </fieldset>
        <div class="showing-preview" data-showing-preview hidden><p class="hint">How it will look on Showing Now:</p><div data-preview-card></div></div>
        <label class="check" data-showing-rights hidden><input name="rights" type="checkbox"/> I made this work, and I have the right to show it.</label>
        <p class="hint" data-publish-note></p>
        <div class="actions"><button data-publish-showing>Publish showing</button><button type="button" data-save-showing-draft>Save as draft</button><button type="button" data-cancel-showing>Cancel</button></div>
        <p data-showing-message role="status"></p>
      </form>

      <section class="tell-people" data-tell-people hidden aria-labelledby="tell-heading">
        <h3 id="tell-heading" data-tell-heading>Tell people</h3>
        <p class="hint">Here’s a note you can send from your own email or phone. Change anything you like. Nothing is sent by Artists Are Jerks.</p>
        <label>Your message<textarea rows="7" data-tell-message></textarea></label>
        <div class="actions">
          <button type="button" data-tell-share hidden>Share…</button>
          <a class="button" data-tell-email>Email it</a>
          <a class="button" data-tell-text>Text it</a>
          <button type="button" data-tell-copy>Copy</button>
          <button type="button" data-tell-calendar>Add to calendar</button>
          <button type="button" data-tell-close>Done</button>
        </div>
        <p data-tell-status role="status"></p>
      </section>

      <section class="opportunities" data-opportunities hidden>
        <h3>Want to hear when local venues are looking for artists?</h3>
        <p>Cafés, breweries, and shops sometimes ask for new work to hang. We can let you know.</p>
        <div class="actions"><button type="button" data-opportunities-answer="yes">Yes, let me know</button><button type="button" data-opportunities-answer="no">No thanks</button></div>
      </section>
    </section>

    <section class="card" data-panel="messages" hidden>
      <h2>Messages</h2>
      <p class="hint">Visitors write to you through the form on your page. Each message is also emailed to you, and replying to that email answers the visitor directly.</p>
      <div class="message-list" data-message-list></div>
      <section class="followers" data-followers hidden>
        <h3>People following your work</h3>
        <p data-follower-count></p>
        <p class="hint">They asked to hear when you show next, and each email lets them stop. The list is yours: download it any time, and nobody else uses it.</p>
        <div class="actions"><button type="button" data-follower-download>Download the list</button></div>
      </section>
    </section>

    <section data-panel="profile" hidden>
      <form class="card" data-setup-profile>
        <h2>About you</h2>
        <div class="fields">
          <label>Artist name<input name="name" required maxlength="150"/></label>
          <label>Home city<input name="city" list="profile-cities" maxlength="120"/><datalist id="profile-cities">{pilot.regions[0]?.cities.map((city) => <option value={city}/>)}</datalist></label>
          <label class="full">What you make<input name="practice" required maxlength="200"/></label>
          <label class="full">Short biography <small>optional</small><textarea name="bio" rows="4" maxlength="2000" placeholder="A few sentences about you and your work"></textarea></label>
        </div>
        <label class="check"><input name="venueOpportunities" type="checkbox"/> Tell me when local venues are looking for artists</label>
        <div class="actions"><button>Save</button></div>
      </form>
      <form class="card" data-setup-contact>
        <h2>Contact details</h2>
        <p>Each one stays private unless you choose to show it. Sales stay between you and the buyer.</p>
        <div class="fields">
          <label class="full">Website<input name="website" type="url" placeholder="https://"/></label>
          <label>Email<input name="email" type="email"/></label>
          <label>Phone or text number<input name="phone" type="tel"/></label>
        </div>
        <label class="check"><input name="publicForm" type="checkbox"/> Show a message form on my page (your email stays private)</label>
        <label class="check"><input name="publicWebsite" type="checkbox"/> Show my website publicly</label>
        <label class="check"><input name="publicEmail" type="checkbox"/> Show my email publicly</label>
        <label class="check"><input name="publicPhone" type="checkbox"/> Show my phone number for calls or texts</label>
        <div class="actions"><button>Save</button></div>
      </form>
    </section>

    <section class="card" data-panel="page" hidden>
      <h2>This is your page</h2>
      <p>Here’s what visitors will see. <a data-member-preview target="_blank" rel="noopener">Open it in a new tab ↗</a></p>
      <iframe class="page-preview" data-page-preview title="Preview of your public page"></iframe>
      <form data-publish-form>
        <fieldset class="reach">
          <legend>How should people reach you?</legend>
          <label class="reach-option"><input type="radio" name="reach" value="form"/><span>With a message form on my page. Your email stays private.</span></label>
          <label class="reach-option"><input type="radio" name="reach" value="website"/><span>Through my website</span></label>
          <label class="reach-website" data-reach-website hidden>Website<input name="website" type="text" inputmode="url" autocapitalize="none" spellcheck="false" placeholder="yourwebsite.com"/></label>
          <label class="reach-option"><input type="radio" name="reach" value="email"/><span>By email, at <span data-reach-email></span></span></label>
          <label class="reach-option"><input type="radio" name="reach" value="none"/><span>Not yet</span></label>
        </fieldset>
        <label class="check" data-rights-field><input name="rights" type="checkbox"/> I made this work, and I have the right to show it.</label>
        <p data-rights-done hidden>You’ve confirmed that you made this work.</p>
        <div class="actions"><button data-publish-member>Publish my page</button><button type="button" data-offline-member hidden>Take my page offline</button><button type="button" data-keep-private>Keep it private for now</button></div>
        <p data-publication-message role="status"></p>
      </form>
      <section class="live-next" data-live-next hidden>
        <h3>You’re live</h3>
        <p>A few good next steps, most important first:</p>
        <div class="actions"><button type="button" data-go="showing">Where can people see your work in person? →</button><button type="button" data-go="artwork">Add another piece</button><button type="button" data-go="profile">Write a short bio</button></div>
      </section>
    </section>
  </div>
</main>
<script>import {initMemberSetup} from '../../lib/member-setup';initMemberSetup();</script>

<style>
  .workspace-return { margin-bottom: var(--space-2); }
  .workspace-return a { font-weight: var(--font-weight-bold); }
  /* Five equal tabs that always fit, even on a phone. */
  .member-tabs { position: sticky; top: 0; z-index: var(--z-sticky); display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); margin-block: var(--space-6); overflow: hidden; border-radius: var(--radius-base); background: var(--color-black); }
  .member-tabs button { min-width: 0; min-height: 44px; padding: var(--space-2) var(--space-1); border: 0; border-radius: 0; background: var(--color-black); color: var(--color-white); font-size: var(--font-size-sm); line-height: var(--line-height-tight); text-align: center; overflow-wrap: normal; }
  @media (max-width: 560px) { .member-tabs { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .member-tabs :global(.unread) { display: inline-block; min-width: var(--space-5); margin-left: var(--space-1); padding: 0 var(--space-1); border-radius: var(--radius-full); background: var(--color-gold); color: var(--color-black); font-size: var(--font-size-xs); }
  .followers { margin-top: var(--space-6); padding-top: var(--space-4); border-top: var(--border-thin) solid var(--color-gray-700); }
  .followers h3 { color: var(--color-gold); }
  .followers p { margin-top: var(--space-2); }
  .message-list { display: grid; gap: var(--space-3); margin-top: var(--space-4); }
  .message-list :global(article) { display: grid; gap: var(--space-2); padding: var(--space-4); border-radius: var(--radius-base); background: var(--color-gray-900); }
  .message-list :global(.new-badge) { justify-self: start; padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); background: var(--color-gold); color: var(--color-black); font-size: var(--font-size-xs); font-weight: var(--font-weight-bold); }
  .message-list :global(.from) { color: var(--color-gold); font-weight: var(--font-weight-bold); }
  .message-list :global(.body) { white-space: pre-wrap; overflow-wrap: anywhere; }
  .member-tabs button[aria-pressed="true"] { background: var(--color-purple); }
  .home-card h2 { margin-bottom: var(--space-2); }
  .home-card p { font-size: var(--font-size-lg); }
  .home-card .primary-action { background: var(--color-gold); color: var(--color-black); border-color: var(--color-gold); font-weight: var(--font-weight-bold); }
  .home-card a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-gold); }

  .drop-zone { position: relative; display: grid; place-items: center; min-height: 280px; margin-block: var(--space-4) var(--space-2); padding: var(--space-4); border: var(--border-base) dashed var(--color-gray-500); border-radius: var(--radius-lg); background: var(--color-artwork-mat); cursor: pointer; text-align: center; }
  .drop-zone:focus-within { outline: var(--border-thick) solid var(--color-gold); outline-offset: var(--border-base); }
  .drop-zone img { width: 100%; max-height: 420px; object-fit: contain; }
  .drop-prompt { display: grid; gap: var(--space-2); }
  .drop-prompt strong { color: var(--color-gold); font-size: var(--font-size-xl); }
  .drop-prompt small { color: var(--color-gray-300); }
  .quiet-button { min-height: 44px; border: 0 !important; background: none !important; color: var(--color-gray-300) !important; text-decoration: underline; padding-inline: 0 !important; }
  .title-field { margin-top: var(--space-4); }
  .more-details { margin-top: var(--space-4); }
  .more-details summary { min-height: 44px; display: flex; align-items: center; color: var(--color-gold); font-weight: var(--font-weight-bold); cursor: pointer; }
  .more-details .fields { margin-block: var(--space-3); }

  .page-preview { width: 100%; height: 560px; margin-block: var(--space-4); border: 0; border-radius: var(--radius-base); background: var(--color-white); }
  .reach { display: grid; gap: var(--space-1); margin: var(--space-4) 0; padding: 0; border: 0; }
  .reach legend { margin-bottom: var(--space-2); font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); }
  .reach-option { display: flex; align-items: center; gap: var(--space-3); min-height: 44px; font-weight: var(--font-weight-normal); }
  .reach-option input { flex: none; width: 20px; height: 20px; accent-color: var(--color-green); }
  .reach-option span { min-width: 0; overflow-wrap: anywhere; }
  .reach-website { margin-left: var(--space-8); }
  .saved-showings { display: grid; gap: var(--space-3); margin-top: var(--space-4); }
  .saved-showings :global(article) { display: grid; gap: var(--space-1); padding: var(--space-4); border-radius: var(--radius-base); background: var(--color-gray-900); }
  .saved-showings :global(h4) { margin: 0; color: var(--color-white); font-size: var(--font-size-lg); }
  .saved-showings :global(.showing-state) { color: var(--color-gold); font-weight: var(--font-weight-bold); }
  .saved-showings :global(.check-in) { padding: var(--space-3); border-radius: var(--radius-sm); background: var(--color-gold); color: var(--color-black); }
  .showing-form { margin-top: var(--space-6); padding-top: var(--space-4); border-top: var(--border-thin) solid var(--color-gray-700); }
  .showing-form fieldset { display: grid; gap: var(--space-2); margin: 0 0 var(--space-6); padding: 0; border: 0; }
  .showing-form legend { margin-bottom: var(--space-2); color: var(--color-gold); font-size: var(--font-size-xl); font-weight: var(--font-weight-bold); }
  .hint { color: var(--color-gray-300); font-size: var(--font-size-sm); }
  .place-results { display: grid; gap: var(--space-2); }
  .place-results :global(button) { justify-content: flex-start; text-align: left; }
  .place-chosen { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); }
  .piece-picker { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: var(--space-3); }
  .piece-picker :global(.piece) { position: relative; display: grid; gap: var(--space-1); padding: var(--space-2); border: var(--border-base) solid var(--color-gray-700); border-radius: var(--radius-base); background: var(--color-artwork-mat); color: var(--color-white); text-align: left; }
  .piece-picker :global(.piece[data-selected]) { border-color: var(--color-green); }
  .piece-picker :global(.piece-toggle) { display: grid; gap: var(--space-1); min-height: 0; padding: 0; border: 0; background: none; color: inherit; text-align: left; }
  .piece-picker :global(.piece img) { width: 100%; aspect-ratio: 4 / 5; object-fit: contain; }
  .piece-picker :global(.piece span) { font-size: var(--font-size-xs); overflow-wrap: anywhere; }
  .piece-picker :global(.star) { position: absolute; top: var(--space-1); right: var(--space-1); width: 44px; min-height: 44px; padding: 0; border: 0; border-radius: var(--radius-full); background: var(--color-black); color: var(--color-gray-400); font-size: var(--font-size-2xl); line-height: var(--line-height-none); }
  .piece-picker :global(.star[aria-pressed="true"]) { color: var(--color-gold); }
  .showing-preview { max-width: 260px; margin-bottom: var(--space-4); }
  .tell-people { margin-top: var(--space-6); padding: var(--space-4); border-radius: var(--radius-base); background: var(--color-gray-900); }
  .tell-people h3 { color: var(--color-gold); }
  .tell-people a.button { display: inline-flex; align-items: center; background: var(--color-purple); color: var(--color-white); border-color: var(--color-white); text-decoration: none; }
  .tell-people label { display: grid; gap: var(--space-2); margin-top: var(--space-3); font-weight: var(--font-weight-bold); }
  .opportunities { margin-top: var(--space-6); padding: var(--space-4); border-radius: var(--radius-base); background: var(--color-purple); }
  .opportunities h3 { color: var(--color-white); }
  .live-next { margin-top: var(--space-6); padding-top: var(--space-4); border-top: var(--border-thin) solid var(--color-gray-700); }
  .live-next h3 { color: var(--color-gold); font-size: var(--font-size-2xl); }

  :global([data-member-works]) { display: grid; gap: var(--space-4); margin-top: var(--space-4); }
  :global([data-member-works] article) { display: grid; grid-template-columns: minmax(120px, 200px) 1fr; gap: var(--space-4); align-items: start; }
  :global([data-member-works] article > img) { width: 100%; height: 180px; object-fit: contain; border-radius: var(--radius-base); background: var(--color-artwork-mat); }
  @media (max-width: 560px) { :global([data-member-works] article) { grid-template-columns: 1fr; } .page-preview { height: 480px; } }
</style>
