---
import Header from '../components/Header.astro';
import AccountIdentity from '../components/AccountIdentity.astro';
import Footer from '../components/Footer.astro';
import BackButton from '../components/BackButton.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';

interface Props {
  title: string;
  bodyClass?: string;
  noindex?: boolean;
}

const { title, bodyClass = '', noindex = false } = Astro.props;
const pathname = Astro.url.pathname;
const figmaMobileCapture = Astro.url.searchParams.get('figma-mobile') === '1';
const hasPageBackButton = pathname === '/artists/' || pathname.startsWith('/artists/') || pathname === '/movements/' || pathname.startsWith('/movements/');
const showAutomaticBackButton = pathname !== '/' && pathname !== '/showing-now/' && !hasPageBackButton;
const showAccountIdentity = import.meta.env.MODE === 'online-test' && (
    pathname === '/account/' ||
    pathname.startsWith('/prototype/workspace') ||
    pathname.startsWith('/prototype/admin/') ||
    pathname.startsWith('/prototype/onboarding/') ||
    pathname.startsWith('/prototype/storage/') ||
    pathname === '/prototype/venues/workspace/'
);
---

<!DOCTYPE html>
<html lang="en" class:list={[bodyClass, { 'figma-mobile-capture': figmaMobileCapture }]}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <script is:inline src="https://mcp.figma.com/mcp/html-to-design/capture.js" async></script>
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Averia+Sans+Libre:wght@400;700&family=Inter:wght@400;600&family=Spicy+Rice&display=swap"
        rel="stylesheet">

    <style is:global>
        /* ============================================
           GLOBAL LAYOUT
           Default: All pages scroll normally (mobile-first)
           ============================================ */

        html,
        body {
            height: auto;
            min-height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
        }

        html.figma-mobile-capture,
        body.figma-mobile-capture {
            width: 390px !important;
            max-width: 390px !important;
        }

        body {
            display: grid;
            grid-template-rows: auto 1fr auto;
            background: var(--color-stage);
        }

        .main-content {
            position: relative;
            min-width: 0;
            width: 100%;
            overflow: visible;
            height: auto;
        }

        .global-back-navigation {
            width: 100%;
            max-width: 1440px;
            margin: 0 auto;
            padding: 8px clamp(1rem, 4vw, 2.5rem) 0;
        }

        @media (max-width: 768px) {
            .main-content > :not(.home-stage):not(.prototype-banner) {
                padding-left: var(--page-gutter-mobile) !important;
                padding-right: var(--page-gutter-mobile) !important;
            }
        }

        /* ============================================
           HOMEPAGE EXCEPTION
           Only the homepage gets fixed height, no scroll
           ============================================ */

        html.homepage,
        body.homepage {
            height: 100%;
            overflow: hidden;
            margin: 0;
            padding: 0;
        }

        body.homepage {
            height: 100vh;
        }

        .homepage .main-content {
            overflow: hidden;
            height: 100%;
            margin: 0;
            padding: 0;
        }

        /* Header and footer styling */
        .site-header {
            width: 100%;
        }

        .site-footer {
            width: 100%;
        }
    </style>
</head>
<body class:list={[bodyClass, { 'figma-mobile-capture': figmaMobileCapture }]}>
    <Header />
    {showAccountIdentity && <AccountIdentity />}

    <main class="main-content">
        {showAutomaticBackButton && <div class="global-back-navigation"><BackButton fallback="/" /></div>}
        <slot />
    </main>

    <Footer />
</body>
</html>
