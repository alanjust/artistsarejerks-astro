{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "aaj-community-local",
  "main": "index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{"binding": "DB", "database_name": "aaj-community-local", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "ARTWORK", "bucket_name": "aaj-artwork-local"}],
  "observability": {"enabled": true}
}
